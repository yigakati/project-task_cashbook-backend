{
  "name": "cashbook-backend",
  "version": "1.0.0",
  "description": "Multi-tenant SaaS financial platform - Cashbooks module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:prod": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:migrate:status": "prisma migrate status",
    "test": "vitest run",
    "test:unit": "vitest run --project=unit",
    "test:integration": "vitest run --project=integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "repair:balances": "tsx scripts/repair-financial-balances.ts",
    "repair:balances:apply": "tsx scripts/repair-financial-balances.ts --apply",
    "seed": "tsx prisma/seed.ts",
    "backfill:ledger": "tsx scripts/backfill-ledger.ts",
    "preflight:baseline": "tsx scripts/preflight-baseline.ts",
    "export:data": "tsx scripts/export-data.ts",
    "build:scripts": "tsc -p tsconfig.scripts.json",
    "ops:backfill-ledger": "node dist-scripts/scripts/backfill-ledger.js",
    "ops:repair-balances": "node dist-scripts/scripts/repair-financial-balances.js",
    "ops:rebuild-attendance": "node dist-scripts/scripts/rebuild-attendance-days.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.893.0",
    "@aws-sdk/s3-request-presigner": "^3.893.0",
    "@prisma/client": "^6.19.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.2",
    "@types/minio": "^7.1.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.2.3",
    "@types/nodemailer": "^7.0.10",
    "@types/pdfkit": "^0.17.5",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.69.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "exceljs": "^3.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "file-type": "^21.3.0",
    "google-auth-library": "^10.6.1",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "ioredis": "^5.9.3",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "minio": "^8.0.7",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.17.2",
    "prisma": "^6.19.2",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.34.5",
    "tsyringe": "^4.10.0",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@swc/core": "^1.15.46",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^3.2.7",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}