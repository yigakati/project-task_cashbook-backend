# Test database — MUST be a throwaway. The harness migrates this database once
# per run, then clones a private copy of it for each parallel test worker.
# It is created automatically if missing (the connecting role needs CREATEDB);
# or create it manually once with:  createdb cashbook_test
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/cashbook_test

# The rest are only needed so config/index.ts validation passes; values are not
# used by tests. Must be present even on a machine with no .env.
JWT_ACCESS_SECRET=test-jwt-secret-value-at-least-32-characters-long
JWT_REFRESH_SECRET=test-refresh-secret-value-at-least-32-characters
