# ===========================================
# APPLICATION
# ===========================================
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
APP_NAME=InChange

# ===========================================
# DATABASE (PostgreSQL)
# ===========================================
DATABASE_URL=postgresql://user:password@localhost:5432/cashbook?schema=public

# ===========================================
# REDIS
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===========================================
# JWT / AUTH
# ===========================================
JWT_ACCESS_SECRET=your-access-token-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-token-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BCRYPT_SALT_ROUNDS=12

# ===========================================
# COOKIES
# ===========================================
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ===========================================
# CORS
# ===========================================
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ===========================================
# AWS S3
# ===========================================

MINIO_ACCESS_KEY=
MINIO_BUCKET=inchange-attachments
MINIO_ENDPOINT=
MINIO_PORT=443
MINIO_SECRET_KEY=
MINIO_USE_SSL=true

# Cloudflare R2
# This API's own externally reachable base URL. Invoice logos are served by
# the API, and the link goes into invoice emails, so this must be reachable
# from outside in production (e.g. https://api.example.com).
API_PUBLIC_URL=http://localhost:5000

# ===========================================
# EMAIL (SMTP / Gmail)
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@cashbook.com
EMAIL_FROM_NAME=InChange

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=debug
LOG_DIR=logs

# ===========================================
# SUPER ADMIN
# ===========================================
SUPER_ADMIN_EMAIL=admin@cashbook.com

# ===========================================
# STORE REVIEW ACCOUNT
# ===========================================
# Ensured on every boot (created, or repaired if its password drifted) so the
# credentials given to Google Play / App Store reviewers always work.
# An ordinary personal account — never a superadmin. Leave the email empty to disable.
REVIEW_ACCOUNT_EMAIL=user@playstore.com
REVIEW_ACCOUNT_PASSWORD=secret2026

# Double-entry ledger mode: off | shadow | on
# 'on' = the ledger is the source of truth and the sole writer of cached balances.
LEDGER_MODE=on

# Where the public contact form forwards messages (sender set as Reply-To).
# Messages are also listed on the Platform page. Set to empty to stop emailing.
SUPPORT_INBOX_EMAIL=info@odixtec.net

# Days between confirming an account deletion and carrying it out (0-30).
# Keep in step with COMPANY.deletionGraceDays in the client's src/config/company.ts.
ACCOUNT_DELETION_GRACE_DAYS=14
