// ─── Catalog (Products/Services + Tax) ─────────────────

// ─── Cross-workspace stock transfers ───────────────────
//
// One platform user moving stock to another, with the app as the shared
// proof. The sender proposes from one of their items; the recipient accepts
// into a workspace of their choosing (picking a matching item or creating
// one). On acceptance both stock movements post atomically — TRANSFER_OUT on
// the sender's side, TRANSFER_IN at the sender's per-unit value on the
// receiver's — so both books agree on what moved and what it was worth.

enum StockTransferStatus {
  /// The requester asked a vendor for stock; awaiting the vendor's decision.
  PENDING
  /// The vendor accepted and released the stock — it has left their
  /// workspace; the requester can now confirm receipt.
  SENT
  /// The requester confirmed receipt into their chosen workspace. Done.
  COMPLETED
  DECLINED
  CANCELLED
}

model StockTransfer {
  id     String              @id @default(uuid()) @db.Uuid
  status StockTransferStatus @default(PENDING)

  senderUserId      String  @map("sender_user_id") @db.Uuid
  /// Null until the vendor sends — a request names a wanted item in notes,
  /// the vendor's real workspace/item only exist once they release stock.
  senderWorkspaceId String? @map("sender_workspace_id") @db.Uuid
  senderItemId      String? @map("sender_item_id") @db.Uuid
  quantity          Int
  /// The vendor's per-unit cost snapshot — informational. The value that
  /// actually moves is computed from the vendor's current weighted average
  /// when the stock leaves, so the two sides can never disagree.
  proposedUnitCost  Decimal @map("proposed_unit_cost") @db.Decimal(20, 4)

  recipientUserId      String? @map("recipient_user_id") @db.Uuid
  /// Chosen by the requester when confirming receipt.
  recipientWorkspaceId String? @map("recipient_workspace_id") @db.Uuid
  /// The requester's item that receives the stock — picked from their
  /// inventory or auto-created from the vendor's details.
  recipientItemId      String? @map("recipient_item_id") @db.Uuid

  /// The requester's expense entry, once recorded (one-time).
  expenseEntryId String? @unique @map("expense_entry_id") @db.Uuid
  /// The vendor's income entry, once recorded (one-time).
  incomeEntryId  String? @unique @map("income_entry_id") @db.Uuid

  notes       String?
  respondedAt DateTime? @map("responded_at")
  sentAt      DateTime? @map("sent_at")
  receivedAt  DateTime? @map("received_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  senderUser         User           @relation("StockTransferSender", fields: [senderUserId], references: [id])
  recipientUser      User?          @relation("StockTransferRecipient", fields: [recipientUserId], references: [id])
  expenseEntry       Entry?         @relation("StockTransferExpense", fields: [expenseEntryId], references: [id], onDelete: SetNull)
  incomeEntry        Entry?         @relation("StockTransferIncome", fields: [incomeEntryId], references: [id], onDelete: SetNull)
  senderWorkspace    Workspace?     @relation("StockTransferSenderWorkspace", fields: [senderWorkspaceId], references: [id], onDelete: Cascade)
  senderItem         InventoryItem? @relation("StockTransferItem", fields: [senderItemId], references: [id], onDelete: Cascade)
  recipientWorkspace Workspace?     @relation("StockTransferRecipientWorkspace", fields: [recipientWorkspaceId], references: [id], onDelete: SetNull)
  recipientItem      InventoryItem? @relation("StockTransferRecipientItem", fields: [recipientItemId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([senderUserId])
  @@index([recipientUserId])
  @@map("stock_transfers")
}

// ─── Cross-workspace rental agreements ─────────────────
//
// Lending an item to another platform user under a contract they accept.
// Proposing reserves the units (they cannot be sold or rented elsewhere while
// the agreement awaits a decision); acceptance converts the reservation into
// a normal rental on the lender's books with the borrower as counterparty.
// Returns flow through the ordinary rental return.

enum RentalAgreementStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

model RentalAgreement {
  id     String                @id @default(uuid()) @db.Uuid
  status RentalAgreementStatus @default(PENDING)

  lenderUserId      String           @map("lender_user_id") @db.Uuid
  lenderWorkspaceId String           @map("lender_workspace_id") @db.Uuid
  lenderItemId      String           @map("lender_item_id") @db.Uuid
  quantity          Int
  periodUnit        RentalPeriodUnit @map("period_unit")
  periodCount       Int              @default(1) @map("period_count")
  startDate         DateTime         @map("start_date")
  endDate           DateTime?        @map("end_date")
  /// Optional charge per period — a loan may be free. Payment, when charged,
  /// is recorded through the ordinary entry flow, not by the agreement.
  rate              Decimal?         @db.Decimal(20, 4)

  borrowerUserId      String  @map("borrower_user_id") @db.Uuid
  /// The borrower's workspace, chosen at acceptance — provenance for the
  /// proof, and where their side of the story lives.
  borrowerWorkspaceId String? @map("borrower_workspace_id") @db.Uuid
  /// The rental created on the lender's books at acceptance.
  rentalId            String? @unique @map("rental_id") @db.Uuid
  /// The borrower's expense entry, once recorded. Unique-set: null until the
  /// one-time record happens, then immutable — the button can never pay twice.
  expenseEntryId      String? @unique @map("expense_entry_id") @db.Uuid
  /// The lender's income entry, once recorded. Same one-time contract.
  incomeEntryId       String? @unique @map("income_entry_id") @db.Uuid

  notes       String?
  respondedAt DateTime? @map("responded_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  lenderUser      User             @relation("RentalAgreementLender", fields: [lenderUserId], references: [id])
  borrowerUser    User             @relation("RentalAgreementBorrower", fields: [borrowerUserId], references: [id])
  lenderWorkspace Workspace        @relation("RentalAgreementLenderWorkspace", fields: [lenderWorkspaceId], references: [id], onDelete: Cascade)
  lenderItem      InventoryItem    @relation("RentalAgreementItem", fields: [lenderItemId], references: [id], onDelete: Cascade)
  rental          InventoryRental? @relation("RentalAgreementRental", fields: [rentalId], references: [id], onDelete: SetNull)
  expenseEntry    Entry?           @relation("RentalAgreementExpense", fields: [expenseEntryId], references: [id], onDelete: SetNull)
  incomeEntry     Entry?           @relation("RentalAgreementIncome", fields: [incomeEntryId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([lenderUserId])
  @@index([borrowerUserId])
  @@map("rental_agreements")
}

// ─── Units of Measure ──────────────────────────────────
//
// Workspace-scoped unit-of-measure vocabulary for inventory items. Items
// reference a unit by name (the historical free-text column) so no migration
// of existing rows is forced; this table is the curated list the UI suggests
// from and manages, unique per workspace.

model UnitOfMeasure {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("units_of_measure")
}

/// The workspace's inventory item-category vocabulary. Items store category
/// as free text (the historical column), so — like units of measure — this
/// curates the vocabulary the item form suggests from, renameable, with the
/// name as the join. A category referenced by items cannot be deleted.
model ItemCategory {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("item_categories")
}

enum ProductServiceType {
  PRODUCT
  SERVICE
}

model Tax {
  id            String   @id @default(uuid()) @db.Uuid
  workspaceId   String   @map("workspace_id") @db.Uuid
  name          String
  rate          Decimal  @db.Decimal(10, 4)
  isCompound    Boolean  @default(false) @map("is_compound")
  isRecoverable Boolean  @default(true) @map("is_recoverable")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  productsServices ProductService[]
  invoiceItems     InvoiceItem[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("taxes")
}

model ProductService {
  id              String             @id @default(uuid()) @db.Uuid
  workspaceId     String             @map("workspace_id") @db.Uuid
  name            String
  description     String?
  price           Decimal            @default(0) @db.Decimal(20, 4)
  currency        String             @default("UGX")
  type            ProductServiceType
  isSellable      Boolean            @default(true) @map("is_sellable")
  isBuyable       Boolean            @default(false) @map("is_buyable")
  taxId           String?            @map("tax_id") @db.Uuid
  inventoryItemId String?            @map("inventory_item_id") @db.Uuid
  isActive        Boolean            @default(true) @map("is_active")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tax           Tax?           @relation(fields: [taxId], references: [id], onDelete: SetNull)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  invoiceItems  InvoiceItem[]

  @@index([workspaceId])
  @@index([type])
  @@index([inventoryItemId])
  @@index([currency])
  @@map("products_services")
}

// ─── Invoicing ─────────────────────────────────────────

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  workspaceId    String        @map("workspace_id") @db.Uuid
  customerId     String        @map("customer_id") @db.Uuid
  invoiceNumber  String        @map("invoice_number")
  status         InvoiceStatus @default(DRAFT)
  issueDate      DateTime      @map("issue_date")
  dueDate        DateTime      @map("due_date")
  currency       String        @default("UGX")
  subtotal       Decimal       @default(0) @db.Decimal(20, 4)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(20, 4)
  taxAmount      Decimal       @default(0) @map("tax_amount") @db.Decimal(20, 4)
  totalAmount    Decimal       @default(0) @map("total_amount") @db.Decimal(20, 4)
  amountPaid     Decimal       @default(0) @map("amount_paid") @db.Decimal(20, 4)
  amountDue      Decimal       @default(0) @map("amount_due") @db.Decimal(20, 4)
  notes          String?
  footer         String?

  /// Who this was billed to, frozen when the invoice left DRAFT.
  ///
  /// The customer relation below is a LIVE row — and for a linked contact it
  /// now refreshes from the counterparty's own profile — so without this an
  /// address change would silently rewrite what every past invoice claims it
  /// was issued to. Null on invoices issued before this existed; readers fall
  /// back to the live customer in that case.
  billToSnapshot Json?         @map("bill_to_snapshot")

  cashbookId     String?       @map("cashbook_id") @db.Uuid
  createdById    String        @map("created_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer  Contact           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  cashbook  Cashbook?         @relation(fields: [cashbookId], references: [id], onDelete: SetNull)
  items     InvoiceItem[]
  rentals   InventoryRental[]

  @@unique([workspaceId, invoiceNumber])
  @@index([workspaceId])
  @@index([customerId])
  @@index([cashbookId])
  @@index([status])
  @@index([issueDate])
  @@index([dueDate])
  @@map("invoices")
}

model InvoiceItem {
  id                String            @id @default(uuid()) @db.Uuid
  invoiceId         String            @map("invoice_id") @db.Uuid
  productServiceId  String?           @map("product_service_id") @db.Uuid
  inventoryItemId   String?           @map("inventory_item_id") @db.Uuid
  lineType          InvoiceLineType   @default(SALE) @map("line_type")
  name              String
  description       String?
  quantity          Decimal           @db.Decimal(20, 4)
  unitPrice         Decimal           @map("unit_price") @db.Decimal(20, 4)
  taxId             String?           @map("tax_id") @db.Uuid
  taxRate           Decimal           @default(0) @map("tax_rate") @db.Decimal(10, 4)
  taxAmount         Decimal           @default(0) @map("tax_amount") @db.Decimal(20, 4)
  total             Decimal           @default(0) @db.Decimal(20, 4)
  rentalStart       DateTime?         @map("rental_start")
  rentalEnd         DateTime?         @map("rental_end")
  rentalPeriodUnit  RentalPeriodUnit? @map("rental_period_unit")
  rentalPeriodCount Int?              @map("rental_period_count")

  invoice        Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productService ProductService? @relation(fields: [productServiceId], references: [id], onDelete: SetNull)
  inventoryItem  InventoryItem?  @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  tax            Tax?            @relation(fields: [taxId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([inventoryItemId])
  @@map("invoice_items")
}

model InvoiceSettings {
  id            String   @id @default(uuid()) @db.Uuid
  workspaceId   String   @unique @map("workspace_id") @db.Uuid
  /// Object key in MinIO, e.g. logos/<workspaceId>-<ms>.png. The only record
  /// of a logo: its public URL is derived from this key at read time, so no
  /// row carries a hostname that a domain change would strand.
  logoKey       String?  @map("logo_key")
  /// Bytes the logo takes against the workspace storage allowance.
  logoSize      Int?     @map("logo_size")
  accentColor   String?  @default("#4F46E5") @map("accent_color")
  template      String   @default("classic") // classic | modern | contemporary
  defaultTerms  String?  @map("default_terms")
  defaultFooter String?  @map("default_footer")
  defaultNotes  String?  @map("default_notes")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("invoice_settings")
}

// ─── Projects ───────────────────────────────────────────

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

/// Per-project delegation. PROJECT_MANAGER here governs ONE project; the
/// workspace-level WorkspaceRole.PROJECT_MANAGER governs every project in the
/// organisation. Different grants, deliberately both kept.
enum ProjectRole {
  PROJECT_MANAGER
  CONTRIBUTOR
  VIEWER
}

model Project {
  id           String        @id @default(uuid()) @db.Uuid
  workspaceId  String        @map("workspace_id") @db.Uuid
  name         String
  description  String?
  status       ProjectStatus @default(ACTIVE)
  startDate    DateTime?     @map("start_date")
  endDate      DateTime?     @map("end_date")
  /// Optional client / customer contact for the project
  contactId    String?       @map("contact_id") @db.Uuid
  /// Optional budget in project currency (no FX)
  budgetAmount Decimal?      @map("budget_amount") @db.Decimal(20, 4)
  currency     String        @default("UGX")
  createdById  String        @map("created_by_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy     User               @relation("ProjectCreator", fields: [createdById], references: [id])
  contact       Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  members       ProjectMember[]
  tasks         Task[]
  timeEntries   TimeEntry[]
  expenseClaims TaskExpenseClaim[]

  @@index([workspaceId])
  @@index([status])
  @@index([createdById])
  @@index([contactId])
  @@map("projects")
}

model ProjectMember {
  id        String      @id @default(uuid()) @db.Uuid
  projectId String      @map("project_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  role      ProjectRole @default(CONTRIBUTOR)
  addedAt   DateTime    @default(now()) @map("added_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

// ─── Tasks ──────────────────────────────────────────────

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  /// Work is finished and an end-of-task report is awaiting review.
  ///
  /// This one value is what makes "members submit a report at the end of each
  /// task" and "a member-created task is approved by a manager once it is
  /// complete" the same mechanism: an assignee cannot reach DONE directly, only
  /// by submitting a report, and only an approver can move it on from here.
  IN_REVIEW
  DONE
}

/// Shared lifecycle for anything that is asked for and then decided.
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  /// Taken back by the requester before anyone decided.
  WITHDRAWN
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id                   String       @id @default(uuid()) @db.Uuid
  workspaceId          String       @map("workspace_id") @db.Uuid
  projectId            String?      @map("project_id") @db.Uuid
  title                String
  description          String?
  status               TaskStatus   @default(TODO)
  priority             TaskPriority @default(MEDIUM)
  dueDate              DateTime?    @map("due_date")
  estimatedTimeMinutes Int?         @map("estimated_time_minutes")
  /// Set when status becomes DONE; cleared if reopened
  completedAt          DateTime?    @map("completed_at")
  createdById          String       @map("created_by_id") @db.Uuid
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  workspace          Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project            Project?                @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy          User                    @relation("TaskCreator", fields: [createdById], references: [id])
  assignments        TaskAssignment[]
  timeEntries        TimeEntry[]
  notifications      Notification[]
  comments           TaskComment[]
  checklist          TaskChecklistItem[]
  assignmentRequests TaskAssignmentRequest[]
  reports            TaskReport[]
  expenseClaims      TaskExpenseClaim[]
  attachments        Attachment[]
  attendanceSite     AttendanceSite?
  clockInSessions    WorkSession[]           @relation("ClockInTask")

  @@index([workspaceId])
  @@index([projectId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([createdById])
  @@index([completedAt])
  @@map("tasks")
}

model TaskAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  taskId     String   @map("task_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  assignedBy String   @map("assigned_by") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")

  task     Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user     User @relation("TaskAssignee", fields: [userId], references: [id], onDelete: Cascade)
  assigner User @relation("TaskAssigner", fields: [assignedBy], references: [id])

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
  @@map("task_assignments")
}

model TaskComment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([authorId])
  @@index([createdAt])
  @@map("task_comments")
}

model TaskChecklistItem {
  id          String    @id @default(uuid()) @db.Uuid
  taskId      String    @map("task_id") @db.Uuid
  title       String
  isDone      Boolean   @default(false) @map("is_done")
  position    Int       @default(0)
  completedAt DateTime? @map("completed_at")
  completedBy String?   @map("completed_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  task      Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  completer User? @relation("ChecklistCompleter", fields: [completedBy], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([position])
  @@map("task_checklist_items")
}

/// "May I take this on?" — a member asks, an approver decides.
///
/// Exists because a member can see every task in a project they belong to but
/// may only act on one they are assigned to. Without this they would have to
/// find a manager out of band.
model TaskAssignmentRequest {
  id          String         @id @default(uuid()) @db.Uuid
  workspaceId String         @map("workspace_id") @db.Uuid
  taskId      String         @map("task_id") @db.Uuid
  requesterId String         @map("requester_id") @db.Uuid
  message     String?
  status      ApprovalStatus @default(PENDING)
  reviewerId  String?        @map("reviewer_id") @db.Uuid
  reviewNote  String?        @map("review_note")
  reviewedAt  DateTime?      @map("reviewed_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requester User      @relation("TaskRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  reviewer  User?     @relation("TaskRequestReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([taskId])
  @@index([requesterId, status])
  /// One live request per person per task — a partial unique index in the
  /// migration, since Prisma cannot express "WHERE status = 'PENDING'".
  @@map("task_assignment_requests")
}

/// The end-of-task report an assignee submits, and a manager reviews.
///
/// Submitting moves the task to IN_REVIEW; approving is the only way it reaches
/// DONE. Rejecting sends it back to IN_PROGRESS with the reviewer's note.
model TaskReport {
  id           String         @id @default(uuid()) @db.Uuid
  workspaceId  String         @map("workspace_id") @db.Uuid
  taskId       String         @map("task_id") @db.Uuid
  authorId     String         @map("author_id") @db.Uuid
  summary      String
  blockers     String?
  minutesSpent Int?           @map("minutes_spent")
  status       ApprovalStatus @default(PENDING)
  reviewerId   String?        @map("reviewer_id") @db.Uuid
  reviewNote   String?        @map("review_note")
  reviewedAt   DateTime?      @map("reviewed_at")
  /// Compare-and-swap guard so two reviewers cannot both decide one report.
  version      Int            @default(1)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task        Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author      User         @relation("TaskReportAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  reviewer    User?        @relation("TaskReportReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  attachments Attachment[]

  @@index([workspaceId, status])
  @@index([taskId])
  @@index([authorId])
  /// One report under review or accepted per task — partial unique in the
  /// migration. A rejected report does not block resubmission.
  @@map("task_reports")
}

/// Where the money came from when the expense was incurred.
enum ExpensePaymentSource {
  /// The member paid out of their own pocket and is owed it back.
  OWN_MONEY
  /// Paid from an organisation wallet, so the money has already left.
  ORG_WALLET
}

/// An expense incurred doing a task, with proof, awaiting a decision.
///
/// Approving posts to the ledger, and what it posts depends on who paid:
///
///   ORG_WALLET -> an EXPENSE entry linked to that wallet. The book balance does
///                 not move but money-out does, and the wallet decreases —
///                 the existing wallet-link rule, unchanged.
///
///   OWN_MONEY  -> a PAYABLE obligation owed to the member's staff contact,
///                 posting Dr Deferred Purchases / Cr Accounts Payable. The
///                 expense reaches the P&L when the org actually reimburses
///                 them, which is correct on this ledger's cash basis, and
///                 "what we owe staff" shows up in AP aging in the meantime.
model TaskExpenseClaim {
  id            String               @id @default(uuid()) @db.Uuid
  workspaceId   String               @map("workspace_id") @db.Uuid
  taskId        String?              @map("task_id") @db.Uuid
  projectId     String?              @map("project_id") @db.Uuid
  claimantId    String               @map("claimant_id") @db.Uuid
  amount        Decimal              @db.Decimal(20, 4)
  currency      String
  description   String
  incurredOn    DateTime             @map("incurred_on") @db.Date
  paymentSource ExpensePaymentSource @map("payment_source")
  /// The wallet the money left. Required when paymentSource is ORG_WALLET,
  /// enforced by a CHECK in the migration.
  accountId     String?              @map("account_id") @db.Uuid
  status        ApprovalStatus       @default(PENDING)
  reviewerId    String?              @map("reviewer_id") @db.Uuid
  reviewNote    String?              @map("review_note")
  reviewedAt    DateTime?            @map("reviewed_at")
  /// Chosen by the approver at the moment of approval, not by the claimant.
  cashbookId    String?              @map("cashbook_id") @db.Uuid
  /// Exactly one of these is set on approval, and each is unique — the database
  /// backstop against a claim posting to the ledger twice.
  entryId       String?              @unique @map("entry_id") @db.Uuid
  obligationId  String?              @unique @map("obligation_id") @db.Uuid
  /// Compare-and-swap guard so two approvers cannot both post one claim.
  version       Int                  @default(1)
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task        Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project     Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  claimant    User                @relation("ExpenseClaimant", fields: [claimantId], references: [id], onDelete: Cascade)
  reviewer    User?               @relation("ExpenseReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  account     Account?            @relation(fields: [accountId], references: [id], onDelete: Restrict)
  cashbook    Cashbook?           @relation(fields: [cashbookId], references: [id], onDelete: Restrict)
  entry       Entry?              @relation(fields: [entryId], references: [id], onDelete: Restrict)
  obligation  CashbookObligation? @relation(fields: [obligationId], references: [id], onDelete: Restrict)
  attachments Attachment[]

  @@index([workspaceId, status])
  @@index([claimantId])
  @@index([taskId])
  @@map("task_expense_claims")
}

// ─── Time Tracking ──────────────────────────────────────

enum TimeEntrySource {
  MANUAL
  TIMER
}

model TimeEntry {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  workspaceId     String          @map("workspace_id") @db.Uuid
  taskId          String?         @map("task_id") @db.Uuid
  projectId       String?         @map("project_id") @db.Uuid
  startTime       DateTime        @map("start_time")
  endTime         DateTime?       @map("end_time")
  durationMinutes Int?            @map("duration_minutes")
  source          TimeEntrySource @default(MANUAL)
  description     String?
  /// Whether this time is billable to a client
  billable        Boolean         @default(true)
  /// Locked entries cannot be edited by the owner (managers can unlock)
  isLocked        Boolean         @default(false) @map("is_locked")
  /// Workspace-local day these minutes belong to. Same reasoning as
  /// WorkSession.businessDate — the previous "day" bucket in the summary was a
  /// UTC slice of startTime, which put evening work on the following day.
  businessDate    DateTime        @map("business_date") @db.Date
  /// Who recorded the entry. Differs from userId when a manager logs time on
  /// someone else's behalf; without it the two are indistinguishable.
  createdById     String          @map("created_by_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy User      @relation("TimeEntryCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([workspaceId])
  @@index([taskId])
  @@index([projectId])
  @@index([startTime])
  @@index([endTime])
  @@index([billable])
  @@index([workspaceId, userId, businessDate])
  @@index([workspaceId, projectId, businessDate])
  /// The partial unique index enforcing one open TIMER per user per workspace is
  /// created in 0008_attendance_timezone_core. It did NOT exist before that
  /// migration, despite a comment here claiming it did — which is why the P2002
  /// handlers in startTimer and clockIn were unreachable.
  @@map("time_entries")
}

/// What someone is doing right now, self-reported while clocked in.
///
/// BREAK and LUNCH are not merely informational: their minutes are subtracted
/// from worked time when the schedule says breaks are unpaid, which is why
/// presence is stored as intervals rather than as a single current value.
enum PresenceStatus {
  AVAILABLE
  WORKING
  BUSY
  BREAK
  LUNCH
  MEETING
}

/// How strictly a workspace treats clocking in away from a known site.
enum GeofenceEnforcement {
  /// No location checking at all.
  OFF
  /// Allowed, but recorded as off-site.
  WARN
  /// Refused.
  ENFORCE
}

/// Half-day leave: which part of the day is covered.
enum LeaveDayPortion {
  FULL
  FIRST_HALF
  SECOND_HALF
}

/// Why someone's attendance on a day is worth a second look.
enum AttendanceFlagType {
  LATE_IN
  EARLY_OUT
  MISSED_CLOCK_OUT
  ABSENT
  OUT_OF_GEOFENCE
}

enum AttendanceFlagStatus {
  ACTIVE
  /// Cancelled by an owner or admin, with a reason on the record.
  WAIVED
}

/// Overtime asked for in advance, or accounted for afterwards.
enum OvertimeRequestType {
  PLANNED
  RETROACTIVE
}

enum WorkReportPeriod {
  DAILY
  MONTHLY
}

/// What a day looked like for one person, after the fact.
enum AttendanceDayStatus {
  PRESENT
  /// Worked, but under what the schedule expected.
  PARTIAL
  /// Expected and did not appear.
  ABSENT
  ON_LEAVE
  HOLIDAY
  /// Not a working day for this person.
  NON_WORKING
}

/// How an open session ended. Anything other than CLOSED means a human did not
/// tap clock-out, which is worth surfacing rather than inferring from nulls.
enum WorkSessionStatus {
  OPEN
  CLOSED
  AUTO_CLOSED
  ADMIN_CLOSED
}

/// Workspace-wide attendance policy.
///
/// A separate table rather than more columns on Workspace: this grows with
/// every people-ops feature, and Workspace is already read on nearly every
/// request.
model AttendanceSettings {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @unique @map("workspace_id") @db.Uuid

  /// Minutes past local midnight at which a business day starts. 0 = midnight.
  /// A workspace running 22:00-06:00 shifts sets this to e.g. 240 so one shift
  /// is not split across two business dates.
  dayBoundaryMinutes Int @default(0) @map("day_boundary_minutes")

  geofenceEnforcement  GeofenceEnforcement @default(WARN) @map("geofence_enforcement")
  /// Whether an assignee may clock in at a site attached to their task.
  allowTaskSiteClockIn Boolean             @default(true) @map("allow_task_site_clock_in")

  /// Track hours past the scheduled end. When off, those minutes are still
  /// MEASURED — see WorkSession.rawOvertimeMinutes — but count as zero.
  overtimeTrackingEnabled Boolean @default(false) @map("overtime_tracking_enabled")
  /// Whether time billable to a client is tracked at all.
  billableTrackingEnabled Boolean @default(true) @map("billable_tracking_enabled")

  /// Minutes before the scheduled end to nudge people to wrap up and report.
  wrapUpReminderMinutes       Int     @default(30) @map("wrap_up_reminder_minutes")
  /// Leaving before the earliest clock-out has to say why.
  earlyClockOutRequiresReason Boolean @default(true) @map("early_clock_out_requires_reason")
  allowClockInWhileOnLeave    Boolean @default(false) @map("allow_clock_in_while_on_leave")
  flagsEnabled                Boolean @default(true) @map("flags_enabled")
  /// Whether everyone can see everyone's presence. Location is never shared
  /// this way — only the status.
  presenceVisibleToAllMembers Boolean @default(true) @map("presence_visible_to_all_members")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("attendance_settings")
}

/// A place someone may clock in from.
///
/// One table for both workspace sites and per-task sites so the geofence check
/// is a single query and a single code path. Two representations of "a circle
/// on the earth" is how a WARN/ENFORCE policy ends up applied inconsistently
/// between them — and it also fixes an existing limitation, since a workspace
/// could previously have only one location.
model AttendanceSite {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  /// Null for a workspace-level site; set for a site attached to one task.
  taskId       String?  @unique @map("task_id") @db.Uuid
  name         String
  latitude     Float
  longitude    Float
  radiusMeters Int      @map("radius_meters")
  isPrimary    Boolean  @default(false) @map("is_primary")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  workspace          Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task               Task?         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  clockedInSessions  WorkSession[] @relation("ClockInSite")
  clockedOutSessions WorkSession[] @relation("ClockOutSite")

  @@index([workspaceId, isActive])
  @@map("attendance_sites")
}

/// Working hours, either the organisation default or one person's override.
///
/// Temporal on purpose. Without effectiveFrom/To, editing the schedule in June
/// silently rewrites January's late-arrival flags, because the flag computation
/// resolves the schedule as it was on the day.
model WorkSchedule {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  /// Null = the organisation default everyone inherits.
  userId      String? @map("user_id") @db.Uuid
  name        String  @default("Standard hours")

  /// ISO weekdays, 1 = Monday .. 7 = Sunday.
  workingDays     Int[]   @map("working_days")
  startTime       String  @map("start_time")
  endTime         String  @map("end_time")
  /// endTime <= startTime, e.g. 22:00-06:00. Derived on write, stored so the
  /// resolver does not have to re-derive it on every read.
  crossesMidnight Boolean @default(false) @map("crosses_midnight")

  /// Minutes after startTime before an arrival counts as late.
  graceMinutes          Int     @default(10) @map("grace_minutes")
  /// Minutes before endTime that leaving is still not "early".
  earlyOutGraceMinutes  Int     @default(10) @map("early_out_grace_minutes")
  breakMinutes          Int     @default(0) @map("break_minutes")
  breakPaid             Boolean @default(false) @map("break_paid")
  expectedMinutesPerDay Int     @map("expected_minutes_per_day")

  /// Advisory windows. There is deliberately no clock-out upper bound.
  clockInWindowStart  String? @map("clock_in_window_start")
  clockInWindowEnd    String? @map("clock_in_window_end")
  clockOutWindowStart String? @map("clock_out_window_start")

  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdById   String?   @map("created_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions  WorkSession[]

  @@index([workspaceId, userId, effectiveFrom])
  @@map("work_schedules")
}

/// A day nobody is expected to work.
model Holiday {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  date        DateTime @db.Date
  name        String
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, date])
  @@map("holidays")
}

/// How long someone spent in each presence state.
///
/// An interval log rather than a single column on the session, because break
/// and lunch minutes have to be SUBTRACTED from worked time — that needs
/// durations, not a current value. WorkSession.presenceStatus caches the open
/// interval's status for the "who is around" view.
model WorkSessionPresence {
  id          String         @id @default(uuid()) @db.Uuid
  sessionId   String         @map("session_id") @db.Uuid
  workspaceId String         @map("workspace_id") @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  status      PresenceStatus
  startedAt   DateTime       @map("started_at")
  endedAt     DateTime?      @map("ended_at")
  minutes     Int?
  note        String?

  session WorkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, startedAt])
  @@index([workspaceId, userId, startedAt])
  @@map("work_session_presence")
}

/// One person, one day, after the fact.
///
/// A derived rollup with a single writer. It exists because absence cannot be
/// computed from rows that exist — "who was missing" needs a day x member grid
/// resolved against schedules, holidays and leave, which is not a GROUP BY over
/// sessions. It is also what keeps an approved report from changing months
/// later because somebody edited the schedule.
model AttendanceDay {
  id           String              @id @default(uuid()) @db.Uuid
  workspaceId  String              @map("workspace_id") @db.Uuid
  userId       String              @map("user_id") @db.Uuid
  businessDate DateTime            @map("business_date") @db.Date
  status       AttendanceDayStatus

  expectedMinutes        Int @default(0) @map("expected_minutes")
  workedMinutes          Int @default(0) @map("worked_minutes")
  breakMinutes           Int @default(0) @map("break_minutes")
  /// Always measured, whatever the overtime toggle says — discarding it makes a
  /// later dispute unresolvable.
  rawOvertimeMinutes     Int @default(0) @map("raw_overtime_minutes")
  /// What rollups and reports actually total. Zero when overtime tracking is
  /// off and no approved request covers the day.
  countedOvertimeMinutes Int @default(0) @map("counted_overtime_minutes")
  billableMinutes        Int @default(0) @map("billable_minutes")
  lateMinutes            Int @default(0) @map("late_minutes")
  earlyOutMinutes        Int @default(0) @map("early_out_minutes")

  firstClockIn DateTime? @map("first_clock_in")
  lastClockOut DateTime? @map("last_clock_out")
  sessionCount Int       @default(0) @map("session_count")
  scheduleId   String?   @map("schedule_id") @db.Uuid
  computedAt   DateTime  @default(now()) @map("computed_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, businessDate])
  @@index([workspaceId, businessDate, status])
  @@map("attendance_days")
}

/// A kind of leave a workspace recognises.
model LeaveType {
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  name           String
  code           String
  /// Whether the day still counts as paid time.
  isPaid         Boolean  @default(true) @map("is_paid")
  allowHalfDay   Boolean  @default(true) @map("allow_half_day")
  maxDaysPerYear Int?     @map("max_days_per_year")
  colorHex       String?  @map("color_hex")
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requests  LeaveRequest[]

  @@unique([workspaceId, code])
  @@unique([workspaceId, name])
  @@map("leave_types")
}

/// Time off, asked for and decided.
model LeaveRequest {
  id           String          @id @default(uuid()) @db.Uuid
  workspaceId  String          @map("workspace_id") @db.Uuid
  userId       String          @map("user_id") @db.Uuid
  leaveTypeId  String          @map("leave_type_id") @db.Uuid
  startDate    DateTime        @map("start_date") @db.Date
  endDate      DateTime        @map("end_date") @db.Date
  startPortion LeaveDayPortion @default(FULL) @map("start_portion")
  endPortion   LeaveDayPortion @default(FULL) @map("end_portion")
  /// Working days covered, halves included — 2.5, not 3.
  totalDays    Decimal         @map("total_days") @db.Decimal(5, 2)
  reason       String
  status       ApprovalStatus  @default(PENDING)
  reviewerId   String?         @map("reviewer_id") @db.Uuid
  reviewNote   String?         @map("review_note")
  reviewedAt   DateTime?       @map("reviewed_at")
  version      Int             @default(1)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User       @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade)
  leaveType LeaveType  @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  reviewer  User?      @relation("LeaveReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  days      LeaveDay[]

  @@index([workspaceId, status])
  @@index([workspaceId, userId, startDate])
  @@map("leave_requests")
}

/// One approved day off, materialised so "is this person expected today" is an
/// indexed join rather than half-day range arithmetic.
///
/// Created on approval and deleted on cancellation. The unique on
/// (workspace, user, date) is the real double-booking backstop — stronger than
/// any overlap check in a service, because it also survives two approvals
/// landing at the same instant.
model LeaveDay {
  id             String          @id @default(uuid()) @db.Uuid
  leaveRequestId String          @map("leave_request_id") @db.Uuid
  workspaceId    String          @map("workspace_id") @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  date           DateTime        @db.Date
  portion        LeaveDayPortion @default(FULL)

  request LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, date])
  @@index([workspaceId, date])
  @@map("leave_days")
}

/// Permission to work past the scheduled end, or a record of having done so.
model OvertimeRequest {
  id               String              @id @default(uuid()) @db.Uuid
  workspaceId      String              @map("workspace_id") @db.Uuid
  userId           String              @map("user_id") @db.Uuid
  businessDate     DateTime            @map("business_date") @db.Date
  type             OvertimeRequestType @default(PLANNED)
  requestedMinutes Int                 @map("requested_minutes")
  reason           String
  status           ApprovalStatus      @default(PENDING)
  /// May be less than requested — an approver can grant part of it.
  approvedMinutes  Int?                @map("approved_minutes")
  reviewerId       String?             @map("reviewer_id") @db.Uuid
  reviewNote       String?             @map("review_note")
  reviewedAt       DateTime?           @map("reviewed_at")
  version          Int                 @default(1)
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("OvertimeRequester", fields: [userId], references: [id], onDelete: Cascade)
  reviewer  User?     @relation("OvertimeReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([workspaceId, userId, businessDate])
  @@map("overtime_requests")
}

/// A late arrival, an early departure, a forgotten clock-out.
///
/// Flags only — no money and no scoring. Waiving one requires a reason and is
/// audit-logged, and is deliberately owner/admin only: HR owns the policy, so
/// erasing a breach of it should not sit with them.
model AttendanceFlag {
  id           String               @id @default(uuid()) @db.Uuid
  workspaceId  String               @map("workspace_id") @db.Uuid
  userId       String               @map("user_id") @db.Uuid
  businessDate DateTime             @map("business_date") @db.Date
  type         AttendanceFlagType
  /// How many minutes past grace, where that makes sense.
  minutes      Int?
  sessionId    String?              @map("session_id") @db.Uuid
  status       AttendanceFlagStatus @default(ACTIVE)
  detail       Json?
  waivedById   String?              @map("waived_by_id") @db.Uuid
  waivedAt     DateTime?            @map("waived_at")
  waiverReason String?              @map("waiver_reason")
  createdAt    DateTime             @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("FlaggedUser", fields: [userId], references: [id], onDelete: Cascade)
  waivedBy  User?     @relation("FlagWaiver", fields: [waivedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, businessDate, status])
  @@index([workspaceId, userId, businessDate])
  @@map("attendance_flags")
}

/// A daily or monthly work report.
///
/// Distinct from TaskReport: that one ends a task, this one covers a period
/// regardless of what was worked on.
model WorkReport {
  id           String           @id @default(uuid()) @db.Uuid
  workspaceId  String           @map("workspace_id") @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  period       WorkReportPeriod
  periodStart  DateTime         @map("period_start") @db.Date
  periodEnd    DateTime         @map("period_end") @db.Date
  summary      String
  blockers     String?
  nextSteps    String?          @map("next_steps")
  /// Hours and task counts as they stood at submission. Snapshotted so a later
  /// time-entry edit cannot silently change what a reviewer already approved.
  metrics      Json?
  status       ApprovalStatus   @default(PENDING)
  submittedAt  DateTime         @default(now()) @map("submitted_at")
  reviewerId   String?          @map("reviewer_id") @db.Uuid
  reviewNote   String?          @map("review_note")
  reviewedAt   DateTime?        @map("reviewed_at")
  /// True when the author could approve reports anyway — recorded rather than
  /// hidden, so the queue does not silently omit them.
  autoApproved Boolean          @default(false) @map("auto_approved")
  version      Int              @default(1)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("WorkReportAuthor", fields: [userId], references: [id], onDelete: Cascade)
  reviewer  User?     @relation("WorkReportReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, userId, period, periodStart])
  @@index([workspaceId, status])
  @@map("work_reports")
}

model WorkSession {
  id                     String            @id @default(uuid()) @db.Uuid
  userId                 String            @map("user_id") @db.Uuid
  workspaceId            String            @map("workspace_id") @db.Uuid
  clockIn                DateTime          @map("clock_in")
  clockOut               DateTime?         @map("clock_out")
  totalMinutes           Int?              @map("total_minutes")
  description            String?
  /// The workspace-local day these minutes belong to, decided at clock-in and
  /// stored rather than derived. Every rollup groups on this: deriving it at
  /// read time would need (ts AT TIME ZONE 'UTC' AT TIME ZONE tz)::date on the
  /// hot path, and would silently re-bucket history if the zone ever changed.
  businessDate           DateTime          @map("business_date") @db.Date
  status                 WorkSessionStatus @default(OPEN)
  /// Cache of the open presence interval. NULL exactly when the session is
  /// closed — a CHECK enforces it, so presence cannot outlive a session.
  presenceStatus         PresenceStatus?   @map("presence_status")
  presenceChangedAt      DateTime?         @map("presence_changed_at")
  /// The schedule as it stood on the day, captured at clock-in. Editing the
  /// schedule later must not retroactively make somebody late.
  scheduleId             String?           @map("schedule_id") @db.Uuid
  scheduledStartUtc      DateTime?         @map("scheduled_start_utc")
  scheduledEndUtc        DateTime?         @map("scheduled_end_utc")
  scheduledMinutes       Int?              @map("scheduled_minutes")
  graceMinutesApplied    Int?              @map("grace_minutes_applied")
  /// Minutes in unpaid BREAK/LUNCH, subtracted from workedMinutes.
  breakMinutes           Int               @default(0) @map("break_minutes")
  workedMinutes          Int?              @map("worked_minutes")
  rawOvertimeMinutes     Int               @default(0) @map("raw_overtime_minutes")
  countedOvertimeMinutes Int               @default(0) @map("counted_overtime_minutes")
  clockInSiteId          String?           @map("clock_in_site_id") @db.Uuid
  clockOutSiteId         String?           @map("clock_out_site_id") @db.Uuid
  /// The task whose site was used to clock in, when one was.
  clockInTaskId          String?           @map("clock_in_task_id") @db.Uuid
  clockInDistanceMeters  Float?            @map("clock_in_distance_meters")
  clockOutDistanceMeters Float?            @map("clock_out_distance_meters")
  clockInLatitude        Float?            @map("clock_in_latitude")
  clockInLongitude       Float?            @map("clock_in_longitude")
  clockInLocationLabel   String?           @map("clock_in_location_label")
  clockInWithinGeofence  Boolean?          @map("clock_in_within_geofence")
  clockOutLatitude       Float?            @map("clock_out_latitude")
  clockOutLongitude      Float?            @map("clock_out_longitude")
  clockOutLocationLabel  String?           @map("clock_out_location_label")
  clockOutWithinGeofence Boolean?          @map("clock_out_within_geofence")
  /// Set when the session did not end with the user tapping clock-out.
  autoClosedAt           DateTime?         @map("auto_closed_at")
  closedById             String?           @map("closed_by_id") @db.Uuid
  closureReason          String?           @map("closure_reason")
  /// Required by policy when clocking out before the configured earliest time.
  earlyOutReason         String?           @map("early_out_reason")
  adjustedById           String?           @map("adjusted_by_id") @db.Uuid
  adjustedAt             DateTime?         @map("adjusted_at")
  adjustmentReason       String?           @map("adjustment_reason")
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  adjustedBy   User?                 @relation("WorkSessionAdjuster", fields: [adjustedById], references: [id], onDelete: SetNull)
  closedBy     User?                 @relation("WorkSessionCloser", fields: [closedById], references: [id], onDelete: SetNull)
  schedule     WorkSchedule?         @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  clockInSite  AttendanceSite?       @relation("ClockInSite", fields: [clockInSiteId], references: [id], onDelete: SetNull)
  clockOutSite AttendanceSite?       @relation("ClockOutSite", fields: [clockOutSiteId], references: [id], onDelete: SetNull)
  clockInTask  Task?                 @relation("ClockInTask", fields: [clockInTaskId], references: [id], onDelete: SetNull)
  presence     WorkSessionPresence[]

  @@index([userId])
  @@index([workspaceId])
  @@index([clockIn])
  @@index([clockOut])
  @@index([workspaceId, businessDate])
  @@index([workspaceId, userId, businessDate])
  /// Partial unique indexes live in the migration, not here — Prisma cannot
  /// express them. See 0008_attendance_timezone_core:
  ///   work_sessions_one_open_per_user  (user_id) WHERE clock_out IS NULL
  @@map("work_sessions")
}

// ─── Notifications ──────────────────────────────────────

enum NotificationType {
  TASK_ASSIGNED
  TASK_DUE_SOON
  TASK_OVERDUE
  TASK_ASSIGNMENT_REQUESTED
  TASK_ASSIGNMENT_DECIDED
  TASK_REPORT_SUBMITTED
  TASK_REPORT_DECIDED
  EXPENSE_CLAIM_SUBMITTED
  EXPENSE_CLAIM_DECIDED
  LEAVE_REQUESTED
  LEAVE_DECIDED
  OVERTIME_REQUESTED
  OVERTIME_DECIDED
  WORK_REPORT_SUBMITTED
  WORK_REPORT_DECIDED
  ATTENDANCE_WRAP_UP
  SESSION_AUTO_CLOSED
  ATTENDANCE_FLAG_RAISED
  PEER_LINK_RECEIVED
  PEER_LINK_DECIDED
  PEER_LINK_PAYMENT_RECORDED
  PEER_LINK_SETTLEMENT_DECIDED
  STOCK_TRANSFER_RECEIVED
  STOCK_TRANSFER_DECIDED
  RENTAL_AGREEMENT_RECEIVED
  RENTAL_AGREEMENT_DECIDED
  CONTACT_LINK_RECEIVED
  CONTACT_LINK_DECIDED
  STORAGE_REQUEST_DECIDED
}

/// What a notification points at, so it can link to something other than a task
/// without adding a nullable foreign key per entity type.
enum NotificationEntityType {
  TASK
  TASK_ASSIGNMENT_REQUEST
  TASK_REPORT
  EXPENSE_CLAIM
  LEAVE_REQUEST
  OVERTIME_REQUEST
  WORK_REPORT
  WORK_SESSION
  ATTENDANCE_FLAG
  PEER_LINK
  PEER_LINK_SETTLEMENT
  STOCK_TRANSFER
  RENTAL_AGREEMENT
  CONTACT_LINK_REQUEST
  STORAGE_QUOTA_REQUEST
}

model Notification {
  id          String                  @id @default(uuid()) @db.Uuid
  userId      String                  @map("user_id") @db.Uuid
  workspaceId String                  @map("workspace_id") @db.Uuid
  type        NotificationType
  title       String
  body        String
  taskId      String?                 @map("task_id") @db.Uuid
  /// Generic target, so a notification can point at a request or a report.
  /// taskId is kept for the rows that predate this and for task-scoped queries.
  entityType  NotificationEntityType? @map("entity_type")
  entityId    String?                 @map("entity_id") @db.Uuid
  /// Deterministic dedupe key. Retries, and any overlap between replicas,
  /// collapse onto one row instead of notifying somebody four times.
  groupKey    String?                 @map("group_key")
  isRead      Boolean                 @default(false) @map("is_read")
  readAt      DateTime?               @map("read_at")
  createdAt   DateTime                @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  /// Nullable groupKey means NULLs stay distinct in Postgres, so unkeyed
  /// notifications are unconstrained — exactly the semantics wanted.
  @@unique([userId, type, groupKey])
  @@index([userId])
  @@index([workspaceId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ═══════════════════════════════════════════════════════════
// ─── Double-entry general ledger ───────────────────────────
// ═══════════════════════════════════════════════════════════
//
// Every financial event posts a balanced JournalEntry. The cached columns on
// Cashbook and Account (balance / totalIncome / totalExpense) are DERIVED from
// this ledger and have exactly one writer: PostingService.
//
// The rule that a wallet-linked entry moves the wallet but not the cashbook's
// book balance is not enforced anywhere here — it falls out of routing the cash
// leg to the wallet's ledger account instead of the cashbook's Book Cash
// account. See src/core/ledger/rules/entry.rules.ts.

enum LedgerAccountClass {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum LedgerAccountOrigin {
  /// Seeded from the chart-of-accounts template.
  SYSTEM
  /// Auto-created 1:1 with a wallet Account.
  WALLET
  /// Auto-created 1:1 with a Cashbook (its unallocated book cash).
  BOOK_CASH
  /// Created by an accountant.
  USER
}

enum JournalStatus {
  POSTED
  /// Superseded: a REVERSING journal cancels this one out.
  REVERSED
  /// This journal is itself the reversal of another.
  REVERSING
}

enum JournalSourceType {
  CASHBOOK_ENTRY
  ACCOUNT_TRANSACTION
  ACCOUNT_TRANSFER
  ACCOUNT_OPENING
  /// Receivables/payables. Invoices post through their obligation, never directly.
  OBLIGATION
  INVENTORY
  MANUAL
}

enum EntryStatus {
  POSTED
  REVERSED
}

enum RevenueBasis {
  CASH
  ACCRUAL
}

enum InventoryValuationMode {
  OFF
  PERPETUAL
}

enum FiscalPeriodStatus {
  OPEN
  CLOSED
}

model LedgerAccount {
  id               String              @id @default(uuid()) @db.Uuid
  workspaceId      String              @map("workspace_id") @db.Uuid
  code             String
  name             String
  class            LedgerAccountClass
  normalBalance    NormalBalance       @map("normal_balance")
  origin           LedgerAccountOrigin @default(USER)
  /// Stable handle for seeded accounts ('AR', 'SALES_REVENUE', ...) so rules can
  /// look them up without depending on user-editable codes or names.
  systemKey        String?             @map("system_key")
  parentId         String?             @map("parent_id") @db.Uuid
  /// Single-currency by construction. No FX: every line must match.
  currency         String
  /// Drives the direct-method cash flow statement.
  isCashEquivalent Boolean             @default(false) @map("is_cash_equivalent")
  /// False for roll-up parents, which exist for presentation only.
  isPostable       Boolean             @default(true) @map("is_postable")
  /// System accounts cannot be renamed, re-coded or deleted.
  isProtected      Boolean             @default(false) @map("is_protected")
  isActive         Boolean             @default(true) @map("is_active")
  archivedAt       DateTime?           @map("archived_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent        LedgerAccount?  @relation("CoaTree", fields: [parentId], references: [id])
  children      LedgerAccount[] @relation("CoaTree")
  lines         JournalLine[]
  walletAccount Account?
  cashbook      Cashbook?
  categories    Category[]

  @@unique([workspaceId, code])
  /// Scoped by currency: a workspace holding both UGX and USD books needs one
  /// Sales Revenue account per currency. There is no FX, so each currency's
  /// books balance independently and no journal ever mixes them.
  @@unique([workspaceId, systemKey, currency])
  @@index([workspaceId, class])
  @@index([workspaceId, currency])
  @@index([parentId])
  @@map("ledger_accounts")
}

model JournalEntry {
  id                     String            @id @default(uuid()) @db.Uuid
  /// Global monotonic ordering key. The stable tie-break for same-date rows in
  /// general-ledger running balances; without it those are non-deterministic.
  seq                    BigInt            @default(autoincrement())
  workspaceId            String            @map("workspace_id") @db.Uuid
  /// Null for org-level events (wallet transfers, direct wallet transactions).
  cashbookId             String?           @map("cashbook_id") @db.Uuid
  /// Business date. Every report filters on this, never on postedAt.
  entryDate              DateTime          @map("entry_date") @db.Date
  postedAt               DateTime          @default(now()) @map("posted_at")
  status                 JournalStatus     @default(POSTED)
  currency               String
  description            String
  sourceType             JournalSourceType @map("source_type")
  sourceId               String?           @map("source_id") @db.Uuid
  /// Deterministic and unique per workspace: 'entry:<id>:v3', 'entry:<id>:v3:rev'.
  /// This is the database-level exactly-once guarantee — it holds even when the
  /// HTTP idempotency middleware is bypassed.
  postingKey             String            @map("posting_key")
  totalDebit             Decimal           @map("total_debit") @db.Decimal(20, 4)
  totalCredit            Decimal           @map("total_credit") @db.Decimal(20, 4)
  reversesJournalEntryId String?           @unique @map("reverses_journal_entry_id") @db.Uuid
  createdById            String            @map("created_by_id") @db.Uuid
  createdAt              DateTime          @default(now()) @map("created_at")

  workspace  Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  cashbook   Cashbook?     @relation(fields: [cashbookId], references: [id], onDelete: Restrict)
  createdBy  User          @relation(fields: [createdById], references: [id])
  reverses   JournalEntry? @relation("JournalReversal", fields: [reversesJournalEntryId], references: [id])
  reversedBy JournalEntry? @relation("JournalReversal")
  lines      JournalLine[]

  @@unique([workspaceId, postingKey])
  @@index([workspaceId, entryDate])
  @@index([cashbookId, entryDate])
  @@index([sourceType, sourceId])
  @@index([workspaceId, status])
  @@map("journal_entries")
}

model JournalLine {
  id             String @id @default(uuid()) @db.Uuid
  journalEntryId String @map("journal_entry_id") @db.Uuid
  lineNumber     Int    @map("line_number")

  /// Denormalized from the header so every report query hits this table alone.
  workspaceId String   @map("workspace_id") @db.Uuid
  cashbookId  String?  @map("cashbook_id") @db.Uuid
  entryDate   DateTime @map("entry_date") @db.Date
  currency    String

  ledgerAccountId String  @map("ledger_account_id") @db.Uuid
  debit           Decimal @default(0) @db.Decimal(20, 4)
  credit          Decimal @default(0) @db.Decimal(20, 4)
  memo            String?

  // ─── Analysis dimensions ───
  /// obligationId is what makes AR/AP aging a pure ledger query.
  contactId       String? @map("contact_id") @db.Uuid
  categoryId      String? @map("category_id") @db.Uuid
  obligationId    String? @map("obligation_id") @db.Uuid
  inventoryItemId String? @map("inventory_item_id") @db.Uuid
  entryId         String? @map("entry_id") @db.Uuid

  journalEntry  JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  ledgerAccount LedgerAccount @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)

  @@unique([journalEntryId, lineNumber])
  @@index([workspaceId, ledgerAccountId, entryDate])
  @@index([workspaceId, cashbookId, entryDate])
  @@index([ledgerAccountId, obligationId])
  @@index([workspaceId, contactId, entryDate])
  @@map("journal_lines")
}

/// Posting lock. Nothing may be posted into or reversed out of a CLOSED period;
/// reversals of closed periods post at the current date instead.
model FiscalPeriod {
  id          String             @id @default(uuid()) @db.Uuid
  workspaceId String             @map("workspace_id") @db.Uuid
  startDate   DateTime           @map("start_date") @db.Date
  endDate     DateTime           @map("end_date") @db.Date
  status      FiscalPeriodStatus @default(OPEN)
  closedById  String?            @map("closed_by_id") @db.Uuid
  closedAt    DateTime?          @map("closed_at")
  note        String?
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, startDate])
  @@index([workspaceId, status])
  @@index([workspaceId, startDate, endDate])
  @@map("fiscal_periods")
}

// ─── Ticketing ─────────────────────────────────────────
//
// A gate desk sells physical admission tickets. The money side is deliberately
// NOT re-invented here: every sale posts one ordinary cashbook Entry through
// EntriesService, which posts the journal, moves the wallet and updates the
// cached balances exactly as a hand-typed entry would. These tables record what
// was sold, at what price, under which offer — the things an Entry cannot say.
//
// Two invariants the shape exists to protect:
//   1. Prices are SNAPSHOT onto TicketSaleLine and Ticket at the moment of sale.
//      Editing Friday's adult price must never rewrite last Friday's takings.
//   2. A TicketDay is the unit of reconciliation. Closing it marks its entries
//      isReconciled, which the ledger already treats as immutable.

enum PatronClass {
  ADULT
  MINOR
  OTHER
}

enum TicketDiscountType {
  /// An adult accompanying N or more minors is admitted free.
  GUARDIAN_COMP
  /// A loyalty tier's standing offer.
  MEMBERSHIP
  /// Buy N of a type, get a discount on the group.
  GROUP
  /// Applied by hand at the desk by someone who may manage ticketing.
  MANUAL
}

enum DiscountValueType {
  /// 0-100, applied to the ticket's gross price.
  PERCENT
  /// Absolute amount off, in the cashbook's currency.
  AMOUNT
}

enum TicketDayStatus {
  OPEN
  CLOSED
}

enum TicketShiftStatus {
  OPEN
  CLOSED
}

enum TicketSaleStatus {
  COMPLETED
  VOIDED
}

enum TicketStatus {
  ISSUED
  VOIDED
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
  CANCELLED
}

/// One-time setup an org completes before the desk can open.
///
/// The superadmin's feature flag only unlocks the module; the org still chooses
/// which book ticket money lands in and which category it counts as, because
/// that is a chart-of-accounts decision nobody outside the org can make.
model TicketSettings {
  id                   String   @id @default(uuid()) @db.Uuid
  workspaceId          String   @unique @map("workspace_id") @db.Uuid
  /// The book every ticket entry posts to — normally a dedicated "Gate /
  /// Tickets" book, so a busy night does not bury the operational books.
  cashbookId           String?  @unique @map("cashbook_id") @db.Uuid
  /// Revenue category for ticket entries. TicketType may override it per tier
  /// when a venue wants adult and minor revenue reported separately.
  revenueCategoryId    String?  @map("revenue_category_id") @db.Uuid
  defaultPaymentModeId String?  @map("default_payment_mode_id") @db.Uuid
  /// Minutes past local midnight at which a new ticketing day begins.
  ///
  /// A night venue rings a sale at 01:30 that belongs to the previous evening's
  /// session and the previous evening's Z-report. 360 = 06:00. Zero means plain
  /// calendar days. Evaluated in Workspace.timezone, never the server's.
  dayStartMinutes      Int      @default(0) @map("day_start_minutes")
  /// Whether an attendant may void their own sale on the current open day.
  /// Off makes every void a supervisor action.
  allowSelfVoid        Boolean  @default(true) @map("allow_self_void")
  /// False until a book and a revenue category are chosen. Selling is refused
  /// while false rather than guessing an account to post to.
  isConfigured         Boolean  @default(false) @map("is_configured")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  workspace          Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cashbook           Cashbook?    @relation(fields: [cashbookId], references: [id], onDelete: SetNull)
  revenueCategory    Category?    @relation(fields: [revenueCategoryId], references: [id], onDelete: SetNull)
  defaultPaymentMode PaymentMode? @relation(fields: [defaultPaymentModeId], references: [id], onDelete: SetNull)

  @@map("ticket_settings")
}

/// A pricing category. In the client's language, "a day": Thursday is one
/// session, Friday another, each with its own tiers and its own offers.
///
/// Either recurring (dayOfWeek) or a one-off override for a single date
/// (specificDate) — never both, enforced by a CHECK in the migration. A
/// specificDate session wins over the weekday one for that date, which is how a
/// public holiday gets its own prices without disturbing the weekly pattern.
model TicketSession {
  id           String    @id @default(uuid()) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  name         String
  description  String?
  /// 0 = Sunday … 6 = Saturday. Null when specificDate is set.
  dayOfWeek    Int?      @map("day_of_week")
  specificDate DateTime? @map("specific_date") @db.Date
  /// Admissions allowed for this session. Null = uncapped.
  capacity     Int?
  isActive     Boolean   @default(true) @map("is_active")
  sortOrder    Int       @default(0) @map("sort_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  types     TicketType[]
  rules     TicketDiscountRule[]
  days      TicketDay[]

  @@index([workspaceId, dayOfWeek])
  @@index([workspaceId, specificDate])
  @@map("ticket_sessions")
}

/// A price tier inside a session: "Adult", "Minor", "VIP".
model TicketType {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @map("workspace_id") @db.Uuid
  sessionId   String      @map("session_id") @db.Uuid
  name        String
  /// Drives the guardian-comp rule, which counts minors and comps an adult.
  patronClass PatronClass @default(ADULT) @map("patron_class")
  price       Decimal     @db.Decimal(20, 4)
  /// Overrides TicketSettings.revenueCategoryId for this tier only.
  categoryId  String?     @map("category_id") @db.Uuid
  capacity    Int?
  isActive    Boolean     @default(true) @map("is_active")
  sortOrder   Int         @default(0) @map("sort_order")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session   TicketSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  category  Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  saleLines TicketSaleLine[]
  tickets   Ticket[]

  @@unique([sessionId, name])
  @@index([workspaceId])
  @@map("ticket_types")
}

/// A conditional offer.
///
/// `config` holds the shape each type needs, so adding an offer kind does not
/// mean a migration:
///   GUARDIAN_COMP { minMinors, compPatronClass, maxCompPerSale }
///   GROUP         { minQuantity, ticketTypeIds }
///   MEMBERSHIP    { ticketTypeIds }  (tier comes from membershipTierId)
model TicketDiscountRule {
  id               String             @id @default(uuid()) @db.Uuid
  workspaceId      String             @map("workspace_id") @db.Uuid
  /// Null applies the rule to every session.
  sessionId        String?            @map("session_id") @db.Uuid
  name             String
  type             TicketDiscountType
  valueType        DiscountValueType  @map("value_type")
  value            Decimal            @db.Decimal(20, 4)
  config           Json               @default("{}")
  membershipTierId String?            @map("membership_tier_id") @db.Uuid
  /// Lower runs first. Ties broken by id for determinism.
  priority         Int                @default(100)
  /// Whether this may apply on top of a rule that already discounted the
  /// ticket. Default false: two offers do not silently compound.
  stackable        Boolean            @default(false)
  isActive         Boolean            @default(true) @map("is_active")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session        TicketSession?  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  membershipTier MembershipTier? @relation(fields: [membershipTierId], references: [id], onDelete: Cascade)
  tickets        Ticket[]

  @@index([workspaceId, isActive])
  @@index([sessionId])
  @@map("ticket_discount_rules")
}

/// One business date × session. The unit a desk opens, sells against and closes.
model TicketDay {
  id           String          @id @default(uuid()) @db.Uuid
  workspaceId  String          @map("workspace_id") @db.Uuid
  sessionId    String          @map("session_id") @db.Uuid
  /// The business date, already resolved through dayStartMinutes. Stored as a
  /// bare date so a night that spans midnight is still one day.
  businessDate DateTime        @map("business_date") @db.Date
  status       TicketDayStatus @default(OPEN)
  /// Snapshot of the session's capacity when the day opened, so raising the
  /// template's cap tomorrow does not retroactively reopen a sold-out night.
  capacity     Int?
  /// Next ticket serial for this day, handed out under the day's row lock.
  nextSerial   Int             @default(1) @map("next_serial")
  openedAt     DateTime        @default(now()) @map("opened_at")
  openedById   String          @map("opened_by_id") @db.Uuid
  closedAt     DateTime?       @map("closed_at")
  closedById   String?         @map("closed_by_id") @db.Uuid
  /// Cash counted against expected at close, per payment mode.
  closingNotes String?         @map("closing_notes")

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session   TicketSession     @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  openedBy  User              @relation("TicketDayOpener", fields: [openedById], references: [id])
  closedBy  User?             @relation("TicketDayCloser", fields: [closedById], references: [id])
  sales     TicketSale[]
  tickets   Ticket[]
  shifts    TicketShift[]
  usages    MembershipUsage[]

  @@unique([workspaceId, businessDate, sessionId])
  @@index([workspaceId, businessDate])
  @@index([workspaceId, status])
  @@map("ticket_days")
}

/// One attendant's cash drawer for one day.
///
/// This is what "reconcile" means at a gate: expected takings from the sales
/// that were rung, against the notes actually in the tin. Without it, ticket
/// cash is never proved against the wallet it was posted to.
model TicketShift {
  id             String            @id @default(uuid()) @db.Uuid
  workspaceId    String            @map("workspace_id") @db.Uuid
  ticketDayId    String            @map("ticket_day_id") @db.Uuid
  attendantId    String            @map("attendant_id") @db.Uuid
  openedAt       DateTime          @default(now()) @map("opened_at")
  closedAt       DateTime?         @map("closed_at")
  openingFloat   Decimal           @default(0) @map("opening_float") @db.Decimal(20, 4)
  /// Per-wallet breakdown (ShiftWalletCount[]), computed at close from this
  /// shift's non-voided sales. Kept as a snapshot so a later void cannot
  /// quietly change what the attendant was held to.
  ///
  /// Defaults to an empty ARRAY, not an object — an open shift has no
  /// breakdown yet (it is computed at close), and every reader treats this
  /// column as a list. A `{}` default here previously crashed the client,
  /// which iterates it with `for...of` / `.map()`; `{}` is not iterable.
  expectedByMode Json              @default("[]") @map("expected_by_mode")
  expectedCash   Decimal           @default(0) @map("expected_cash") @db.Decimal(20, 4)
  countedCash    Decimal?          @map("counted_cash") @db.Decimal(20, 4)
  /// countedCash − expectedCash. Negative is short.
  variance       Decimal?          @db.Decimal(20, 4)
  status         TicketShiftStatus @default(OPEN)
  closedById     String?           @map("closed_by_id") @db.Uuid
  notes          String?

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ticketDay TicketDay    @relation(fields: [ticketDayId], references: [id], onDelete: Cascade)
  attendant User         @relation("ShiftAttendant", fields: [attendantId], references: [id])
  closedBy  User?        @relation("ShiftCloser", fields: [closedById], references: [id])
  sales     TicketSale[]

  @@index([workspaceId, status])
  @@index([ticketDayId])
  @@index([attendantId])
  @@map("ticket_shifts")
}

/// One confirm tap at the desk.
model TicketSale {
  id             String           @id @default(uuid()) @db.Uuid
  workspaceId    String           @map("workspace_id") @db.Uuid
  ticketDayId    String           @map("ticket_day_id") @db.Uuid
  shiftId        String?          @map("shift_id") @db.Uuid
  /// The cashbook entry this sale posted. Null only when the whole sale was
  /// comped to zero — there is no money to record, and a zero-amount entry
  /// would fail validation. The tickets are still issued and still counted.
  entryId        String?          @unique @map("entry_id") @db.Uuid
  /// The wallet the money went into. Required even for a comped sale so the
  /// desk's configuration is recorded consistently.
  accountId      String           @map("account_id") @db.Uuid
  paymentModeId  String?          @map("payment_mode_id") @db.Uuid
  membershipId   String?          @map("membership_id") @db.Uuid
  grossAmount    Decimal          @map("gross_amount") @db.Decimal(20, 4)
  discountAmount Decimal          @default(0) @map("discount_amount") @db.Decimal(20, 4)
  /// What was actually collected, and what the Entry is for.
  netAmount      Decimal          @map("net_amount") @db.Decimal(20, 4)
  ticketCount    Int              @map("ticket_count")
  status         TicketSaleStatus @default(COMPLETED)
  soldById       String           @map("sold_by_id") @db.Uuid
  soldAt         DateTime         @default(now()) @map("sold_at")
  voidedAt       DateTime?        @map("voided_at")
  voidedById     String?          @map("voided_by_id") @db.Uuid
  voidReason     String?          @map("void_reason")
  /// Optimistic concurrency, matching the discipline on Entry.
  version        Int              @default(1)

  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ticketDay   TicketDay         @relation(fields: [ticketDayId], references: [id], onDelete: Cascade)
  shift       TicketShift?      @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  entry       Entry?            @relation(fields: [entryId], references: [id], onDelete: SetNull)
  account     Account           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  paymentMode PaymentMode?      @relation(fields: [paymentModeId], references: [id], onDelete: SetNull)
  membership  Membership?       @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  soldBy      User              @relation("TicketSeller", fields: [soldById], references: [id])
  voidedBy    User?             @relation("TicketVoider", fields: [voidedById], references: [id])
  lines       TicketSaleLine[]
  tickets     Ticket[]
  usages      MembershipUsage[]

  @@index([workspaceId, soldAt])
  @@index([ticketDayId, status])
  @@index([soldById])
  @@index([shiftId])
  @@map("ticket_sales")
}

/// A sale's request, per tier: "2 × Minor at 10,000".
model TicketSaleLine {
  id           String  @id @default(uuid()) @db.Uuid
  saleId       String  @map("sale_id") @db.Uuid
  ticketTypeId String  @map("ticket_type_id") @db.Uuid
  quantity     Int
  /// Snapshot. The tier's price may change tomorrow; this line may not.
  unitPrice    Decimal @map("unit_price") @db.Decimal(20, 4)
  lineGross    Decimal @map("line_gross") @db.Decimal(20, 4)
  lineDiscount Decimal @default(0) @map("line_discount") @db.Decimal(20, 4)
  lineNet      Decimal @map("line_net") @db.Decimal(20, 4)

  sale       TicketSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@map("ticket_sale_lines")
}

/// One physical admission.
///
/// Issued per head rather than per line because the offers work per head: an
/// adult with two minors yields three tickets, one of which is free. Rolling
/// that into a line total would lose which head was comped and why.
model Ticket {
  id             String       @id @default(uuid()) @db.Uuid
  workspaceId    String       @map("workspace_id") @db.Uuid
  saleId         String       @map("sale_id") @db.Uuid
  ticketDayId    String       @map("ticket_day_id") @db.Uuid
  ticketTypeId   String       @map("ticket_type_id") @db.Uuid
  /// TKT-YYYYMMDD-0001, allocated from TicketDay.nextSerial under its row lock.
  serialNo       String       @map("serial_no")
  patronClass    PatronClass  @map("patron_class")
  grossPrice     Decimal      @map("gross_price") @db.Decimal(20, 4)
  discountAmount Decimal      @default(0) @map("discount_amount") @db.Decimal(20, 4)
  netPrice       Decimal      @map("net_price") @db.Decimal(20, 4)
  /// Which offer produced the discount, for the analytics page and for anyone
  /// asking six months later why this adult got in free.
  appliedRuleId  String?      @map("applied_rule_id") @db.Uuid
  status         TicketStatus @default(ISSUED)
  createdAt      DateTime     @default(now()) @map("created_at")

  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sale        TicketSale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  ticketDay   TicketDay           @relation(fields: [ticketDayId], references: [id], onDelete: Cascade)
  ticketType  TicketType          @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  appliedRule TicketDiscountRule? @relation(fields: [appliedRuleId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, serialNo])
  @@index([ticketDayId, status])
  @@index([saleId])
  @@map("tickets")
}

// ─── Memberships (loyalty) ─────────────────────────────

/// A loyalty tier and the standing offer that comes with it.
model MembershipTier {
  id                     String            @id @default(uuid()) @db.Uuid
  workspaceId            String            @map("workspace_id") @db.Uuid
  name                   String
  description            String?
  discountValueType      DiscountValueType @default(PERCENT) @map("discount_value_type")
  discountValue          Decimal           @default(0) @map("discount_value") @db.Decimal(20, 4)
  /// Tiers this offer applies to. Empty = every tier in the session.
  appliesToTicketTypeIds String[]          @default([]) @map("applies_to_ticket_type_ids") @db.Uuid
  /// How many tickets per business day the offer may cover. Null = unlimited.
  /// Without this, one card discounts a coach party.
  maxUsesPerDay          Int?              @map("max_uses_per_day")
  /// How long a new or renewed membership runs. Null = no expiry.
  validityMonths         Int?              @map("validity_months")
  /// What the membership itself sells for. Set means issuing one posts its own
  /// income entry — membership fees are revenue, not paperwork.
  price                  Decimal?          @db.Decimal(20, 4)
  isActive               Boolean           @default(true) @map("is_active")
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")

  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memberships Membership[]
  rules       TicketDiscountRule[]

  @@unique([workspaceId, name])
  @@index([workspaceId, isActive])
  @@map("membership_tiers")
}

/// Somebody's loyalty card.
///
/// Layered on Contact rather than carrying its own name and phone, so a
/// member's tickets, receipts and any invoices all hang off one customer record
/// instead of three spellings of the same person.
model Membership {
  id          String           @id @default(uuid()) @db.Uuid
  workspaceId String           @map("workspace_id") @db.Uuid
  contactId   String           @map("contact_id") @db.Uuid
  tierId      String           @map("tier_id") @db.Uuid
  /// What the attendant types at the desk. Generated M-00001, or the number
  /// already printed on a physical card.
  memberNo    String           @map("member_no")
  validFrom   DateTime         @default(now()) @map("valid_from")
  validUntil  DateTime?        @map("valid_until")
  status      MembershipStatus @default(ACTIVE)
  issuedById  String           @map("issued_by_id") @db.Uuid
  /// The income entry for the joining or renewal fee, when the tier charges one.
  entryId     String?          @unique @map("entry_id") @db.Uuid
  notes       String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tier      MembershipTier    @relation(fields: [tierId], references: [id], onDelete: Restrict)
  issuedBy  User              @relation("MembershipIssuer", fields: [issuedById], references: [id])
  entry     Entry?            @relation(fields: [entryId], references: [id], onDelete: SetNull)
  sales     TicketSale[]
  usages    MembershipUsage[]

  @@unique([workspaceId, memberNo])
  @@index([workspaceId, status])
  @@index([contactId])
  @@map("memberships")
}

/// Every time a card actually earned a discount.
///
/// Exists for two reasons: enforcing MembershipTier.maxUsesPerDay, and being
/// able to answer "what has this card saved you this year" without replaying
/// every sale.
model MembershipUsage {
  id             String   @id @default(uuid()) @db.Uuid
  membershipId   String   @map("membership_id") @db.Uuid
  saleId         String   @map("sale_id") @db.Uuid
  ticketDayId    String   @map("ticket_day_id") @db.Uuid
  /// Tickets this redemption covered, for the per-day cap.
  ticketCount    Int      @default(1) @map("ticket_count")
  discountAmount Decimal  @map("discount_amount") @db.Decimal(20, 4)
  usedAt         DateTime @default(now()) @map("used_at")

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  sale       TicketSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  ticketDay  TicketDay  @relation(fields: [ticketDayId], references: [id], onDelete: Cascade)

  @@unique([saleId, membershipId])
  @@index([membershipId, ticketDayId])
  @@map("membership_usages")
}

// ─── API Keys ──────────────────────────────────────────
//
// One workspace may have many named API keys. They are workspace-scoped:
// the caller presents a key + a bookRef to target a specific cashbook.
//
// Security model:
//   - Raw key = "ick_live_<32-random-bytes-as-base64url>"
//   - Stored:   SHA-256(rawKey)  — never the raw key itself.
//   - The raw key is returned ONCE at creation; we cannot show it again.
//   - Rotation generates a new raw key, replaces the hash, and zeroes lastUsedAt.
//
// The keyPrefix field stores the first 12 chars of the raw key for display in
// the UI so users can identify which key is which without us storing the secret.

enum ApiKeyScope {
  /// Can create entries in the specified cashbook(s).
  WRITE_ENTRIES
  /// Read entries / balance for the specified cashbook(s).
  READ_ENTRIES
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

model ApiKey {
  id             String        @id @default(uuid()) @db.Uuid
  workspaceId    String        @map("workspace_id") @db.Uuid
  /// Human-readable label, e.g. "POS System", "E-commerce Store".
  name           String
  /// SHA-256 hash of the raw API key (hex-encoded). Never store the raw key.
  keyHash        String        @unique @map("key_hash")
  /// First 12 characters of the raw key for display purposes only.
  keyPrefix      String        @map("key_prefix")
  /// What this key is allowed to do. At least one scope is required.
  scopes         ApiKeyScope[]
  status         ApiKeyStatus  @default(ACTIVE)
  /// The user who created this key.
  createdById    String        @map("created_by_id") @db.Uuid
  /// Cashbooks this key can access (by internal id). Empty array means no
  /// book access; key creation requires at least one active book.
  allowedBookIds String[]      @default([]) @map("allowed_book_ids") @db.Uuid
  /// Exact IPv4/IPv6 addresses this key is allowed to call from.
  /// Empty array = no IP restriction.
  allowedIps     String[]      @default([]) @map("allowed_ips")
  lastUsedAt     DateTime?     @map("last_used_at")
  expiresAt      DateTime?     @map("expires_at")
  revokedAt      DateTime?     @map("revoked_at")
  revokedById    String?       @map("revoked_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("ApiKeyCreator", fields: [createdById], references: [id])
  revokedBy User?     @relation("ApiKeyRevoker", fields: [revokedById], references: [id])

  @@index([workspaceId])
  @@index([keyHash])
  @@index([status])
  @@map("api_keys")
}

// ─── File storage allowance ────────────────────────────
//
// Nothing new is stored here: usage is counted from files that already exist
// (attachments and the invoice logo). What this adds is the ceiling, and the
// way to ask a superadmin to raise it.

enum StorageRequestStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

/// A workspace asking a superadmin for more file storage.
model StorageQuotaRequest {
  id             String               @id @default(uuid()) @db.Uuid
  workspaceId    String               @map("workspace_id") @db.Uuid
  requestedById  String               @map("requested_by_id") @db.Uuid
  /// The total allowance asked for, not an increment, so what gets approved
  /// is never ambiguous.
  requestedBytes BigInt               @map("requested_bytes")
  reason         String?
  status         StorageRequestStatus @default(PENDING)
  /// What the superadmin actually granted — may differ from what was asked.
  grantedBytes   BigInt?              @map("granted_bytes")
  decidedById    String?              @map("decided_by_id") @db.Uuid
  decisionNote   String?              @map("decision_note")
  decidedAt      DateTime?            @map("decided_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requestedBy User      @relation("StorageRequester", fields: [requestedById], references: [id])
  decidedBy   User?     @relation("StorageDecider", fields: [decidedById], references: [id])

  @@index([workspaceId, status])
  @@index([status, createdAt])
  @@map("storage_quota_requests")
}

// ─── Account deletion ──────────────────────────────────
//
// Required by app stores: a person must be able to delete their account from
// inside the app and from the web without signing in. A request moves through
// a grace period before anything is removed, so a mistaken or malicious
// request can be cancelled by the real owner.

enum AccountDeletionStatus {
  /// Asked for on the web; waiting for the owner to click the emailed link.
  PENDING_VERIFICATION
  /// Confirmed; runs automatically at scheduledFor unless cancelled.
  SCHEDULED
  /// Claimed by a worker and being carried out right now.
  PROCESSING
  /// Cannot run until something is resolved (see blockers), e.g. the person
  /// still owns a business that has other members.
  BLOCKED
  CANCELLED
  /// The emailed link was never used.
  EXPIRED
  COMPLETED
  /// Errored while running; nothing was committed. Safe to retry.
  FAILED
}

enum AccountDeletionSource {
  IN_APP
  WEB
  ADMIN
}

model AccountDeletionRequest {
  id                    String                @id @default(uuid()) @db.Uuid
  userId                String                @map("user_id") @db.Uuid
  source                AccountDeletionSource
  status                AccountDeletionStatus
  reason                String?
  /// Where this request's emails go. Cleared once the deletion completes and
  /// the final confirmation has been sent, so no address outlives the account.
  contactEmail          String?               @map("contact_email")
  /// SHA-256 of the emailed confirmation token; the token itself is never stored.
  verificationTokenHash String?               @unique @map("verification_token_hash")
  verificationExpiresAt DateTime?             @map("verification_expires_at")
  scheduledFor          DateTime?             @map("scheduled_for")
  verifiedAt            DateTime?             @map("verified_at")
  cancelledAt           DateTime?             @map("cancelled_at")
  completedAt           DateTime?             @map("completed_at")
  /// The superadmin who scheduled, cancelled or forced this request, if any.
  handledById           String?               @map("handled_by_id") @db.Uuid
  adminNote             String?               @map("admin_note")
  /// Why it cannot run yet (BLOCKED), as shown to the person and the admin.
  blockers              Json?
  /// What was removed, by count — kept as the record that it was carried out.
  summary               Json?
  failureReason         String?               @map("failure_reason")
  attempts              Int                   @default(0)
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  user      User  @relation("DeletionSubject", fields: [userId], references: [id], onDelete: Cascade)
  handledBy User? @relation("DeletionHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status, scheduledFor])
  @@index([userId])
  @@map("account_deletion_requests")
}

// ─── Contact form ──────────────────────────────────────

enum ContactMessageStatus {
  OPEN
  RESOLVED
}

/// A message sent from the public contact page. Stored so nothing is lost when
/// email delivery fails, and so superadmins can work through them in one place.
model ContactMessage {
  id             String               @id @default(uuid()) @db.Uuid
  name           String
  email          String
  category       String
  subject        String
  message        String
  status         ContactMessageStatus @default(OPEN)
  resolvedAt     DateTime?            @map("resolved_at")
  resolvedById   String?              @map("resolved_by_id") @db.Uuid
  resolutionNote String?              @map("resolution_note")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  resolvedBy User? @relation("ContactMessageResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("contact_messages")
}
