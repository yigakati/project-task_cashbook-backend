model AccountTransaction {
  id                String                @id @default(uuid()) @db.Uuid
  workspaceId       String                @map("workspace_id") @db.Uuid
  accountId         String                @map("account_id") @db.Uuid
  sourceType        TransactionSourceType @map("source_type")
