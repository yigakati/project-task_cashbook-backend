generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User ──────────────────────────────────────────────

model User {
  id            String       @id @default(uuid()) @db.Uuid
  email         String       @unique
  passwordHash  String?      @map("password_hash")
  firstName     String       @map("first_name")
  lastName      String       @map("last_name")
  provider      AuthProvider @default(LOCAL)
  providerId    String?      @map("provider_id")
  isActive      Boolean      @default(true) @map("is_active")
  isSuperAdmin  Boolean      @default(false) @map("is_super_admin")
  emailVerified Boolean      @default(false) @map("email_verified")
  lastLoginAt   DateTime?    @map("last_login_at")
  /// Set when the account was deleted. The row stays as an anonymised
  /// tombstone ("Deleted user") because other businesses' entries, journals and
  /// HR records still name whoever created them; every personal field is
  /// scrubbed at the same moment. See AccountDeletionService.
  deletedAt     DateTime?    @map("deleted_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  refreshTokens            RefreshToken[]
  deletionRequests         AccountDeletionRequest[] @relation("DeletionSubject")
  deletionRequestsHandled  AccountDeletionRequest[] @relation("DeletionHandler")
  contactMessagesResolved  ContactMessage[]         @relation("ContactMessageResolver")
  loginHistory             LoginHistory[]
  ownedWorkspaces          Workspace[]             @relation("WorkspaceOwner")
  workspaceMemberships     WorkspaceMember[]
  cashbookMemberships      CashbookMember[]
  entries                  Entry[]
  entryAudits              EntryAudit[]
  deleteRequests           DeleteRequest[]         @relation("DeleteRequester")
  deleteReviews            DeleteRequest[]         @relation("DeleteReviewer")
  auditLogs                AuditLog[]
  financialAuditLogs       FinancialAuditLog[]
  sentInvites              PendingInvite[]         @relation("InviteSender")
  projectsCreated          Project[]               @relation("ProjectCreator")
  projectMemberships       ProjectMember[]
  tasksCreated             Task[]                  @relation("TaskCreator")
  taskAssignments          TaskAssignment[]        @relation("TaskAssignee")
  taskAssigned             TaskAssignment[]        @relation("TaskAssigner")
  taskComments             TaskComment[]
  checklistItemsDone       TaskChecklistItem[]     @relation("ChecklistCompleter")
  taskRequestsMade         TaskAssignmentRequest[] @relation("TaskRequestRequester")
  taskRequestsReviewed     TaskAssignmentRequest[] @relation("TaskRequestReviewer")
  taskReportsWritten       TaskReport[]            @relation("TaskReportAuthor")
  expenseClaimsMade        TaskExpenseClaim[]      @relation("ExpenseClaimant")
  expenseClaimsReviewed    TaskExpenseClaim[]      @relation("ExpenseReviewer")
  staffContacts            Contact[]
  taskReportsReviewed      TaskReport[]            @relation("TaskReportReviewer")
  timeEntries              TimeEntry[]
  timeEntriesCreated       TimeEntry[]             @relation("TimeEntryCreator")
  workSessions             WorkSession[]
  workSchedules            WorkSchedule[]
  attendanceDays           AttendanceDay[]
  leaveRequests            LeaveRequest[]          @relation("LeaveRequester")
  leaveReviewed            LeaveRequest[]          @relation("LeaveReviewer")
  overtimeRequests         OvertimeRequest[]       @relation("OvertimeRequester")
  overtimeReviewed         OvertimeRequest[]       @relation("OvertimeReviewer")
  attendanceFlags          AttendanceFlag[]        @relation("FlaggedUser")
  flagsWaived              AttendanceFlag[]        @relation("FlagWaiver")
  workReports              WorkReport[]            @relation("WorkReportAuthor")
  workReportsReviewed      WorkReport[]            @relation("WorkReportReviewer")
  workSessionsAdjusted     WorkSession[]           @relation("WorkSessionAdjuster")
  workSessionsClosed       WorkSession[]           @relation("WorkSessionCloser")
  notifications            Notification[]
  journalEntries           JournalEntry[]
  featuresEnabled          WorkspaceFeature[]      @relation("FeatureEnabler")
  ticketDaysOpened         TicketDay[]             @relation("TicketDayOpener")
  ticketDaysClosed         TicketDay[]             @relation("TicketDayCloser")
  ticketShifts             TicketShift[]           @relation("ShiftAttendant")
  ticketShiftsClosed       TicketShift[]           @relation("ShiftCloser")
  ticketSales              TicketSale[]            @relation("TicketSeller")
  ticketSalesVoided        TicketSale[]            @relation("TicketVoider")
  membershipsIssued        Membership[]            @relation("MembershipIssuer")
  apiKeysCreated           ApiKey[]                @relation("ApiKeyCreator")
  apiKeysRevoked           ApiKey[]                @relation("ApiKeyRevoker")
  linkedIdentities         LinkedIdentity[]
  contactLinksRequested    ContactLinkRequest[]    @relation("ContactLinkRequester")
  contactLinksReceived     ContactLinkRequest[]    @relation("ContactLinkRecipient")
  referralAgent            ReferralAgent?          @relation("ReferralAgentUser")
  referralAgentsAppointed  ReferralAgent[]         @relation("ReferralAgentAppointer")
  platformSettingsEdited   PlatformSetting[]       @relation("PlatformSettingEditor")
  referredBy               Referral?               @relation("ReferredUser")
  storageRequestsMade      StorageQuotaRequest[]   @relation("StorageRequester")
  storageRequestsDecided   StorageQuotaRequest[]   @relation("StorageDecider")
  settlementsRecorded      PeerLinkSettlement[]    @relation("PeerLinkSettlementRecorder")
  peerLinksInitiated       PeerLink[]              @relation("PeerLinkInitiator")
  peerLinksReceived        PeerLink[]              @relation("PeerLinkCounterparty")
  stockTransfersSent       StockTransfer[]         @relation("StockTransferSender")
  stockTransfersReceived   StockTransfer[]         @relation("StockTransferRecipient")
  rentalAgreementsLent     RentalAgreement[]       @relation("RentalAgreementLender")
  rentalAgreementsBorrowed RentalAgreement[]       @relation("RentalAgreementBorrower")

  @@unique([provider, providerId])
  @@map("users")
}

// ─── Auth ──────────────────────────────────────────────

/**
 * One row per OAuth identity linked to a user — the actual source of truth
 * for "can this Google/OC account sign this person in", queried instead of
 * `User.provider`/`User.providerId` wherever login resolves an identity.
 * `User.provider`/`providerId` stay as a single, immutable record of how the
 * account was originally created (useful for display/audit) but are never
 * mutated after signup — mutating them to "the most recently used provider"
 * is exactly the bug this table replaces: a single-slot column can't
 * represent a user who signed up locally, then linked Google, then also
 * linked OC. Every provider a user has ever authenticated with — including
 * their original signup provider — gets a row here.
 */
model LinkedIdentity {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  provider   AuthProvider
  providerId String       @map("provider_id")
  email      String
  linkedAt   DateTime     @default(now()) @map("linked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@map("linked_identities")
}

model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @map("token_hash")
  deviceInfo String?  @map("device_info")
  ipAddress  String?  @map("ip_address")
  expiresAt  DateTime @map("expires_at")
  isRevoked  Boolean  @default(false) @map("is_revoked")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model LoginHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  status    String
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("login_history")
}

// ─── Workspace ─────────────────────────────────────────

model Workspace {
  id                      String                 @id @default(uuid()) @db.Uuid
  name                    String
  type                    WorkspaceType
  ownerId                 String                 @map("owner_id") @db.Uuid
  /// Workspace base currency. The app does not perform FX conversion.
  defaultCurrency         String                 @default("UGX") @map("default_currency")
  attendanceLocationName  String?                @map("attendance_location_name")
  attendanceLatitude      Float?                 @map("attendance_latitude")
  attendanceLongitude     Float?                 @map("attendance_longitude")
  attendanceRadiusMeters  Int?                   @map("attendance_radius_meters")
  /// Earliest clock-in (workspace-local HH:MM, 24h). Null = no restriction.
  attendanceClockInStart  String?                @map("attendance_clock_in_start")
  /// Latest clock-in (workspace-local HH:MM, 24h). Null = no restriction.
  attendanceClockInEnd    String?                @map("attendance_clock_in_end")
  /// Earliest clock-out (workspace-local HH:MM, 24h). Advisory: leaving before
  /// this raises an EARLY_OUT flag, it does not refuse the clock-out.
  attendanceClockOutStart String?                @map("attendance_clock_out_start")
  /// Whether the clock-in window REFUSES a late arrival rather than flagging it.
  /// Off by default: refusing means a late employee records no attendance at
  /// all, which is worse than recording it as late.
  enforceClockWindows     Boolean                @default(false) @map("enforce_clock_windows")
  /// IANA zone every wall-clock attendance policy is evaluated in. Before this
  /// existed the comparison used the server container's zone, so a Kampala
  /// workspace allowing 08:00-09:30 really allowed 11:00-12:30 local.
  timezone                String                 @default("Africa/Kampala")
  isActive                Boolean                @default(true) @map("is_active")
  /// CASH: revenue recognized when cash lands (obligations post via a deferred
  /// offset so AR still appears on the balance sheet). ACCRUAL is reserved and
  /// not implemented — switching it would decouple Cashbook.totalIncome from
  /// ledger income.
  revenueBasis            RevenueBasis           @default(CASH) @map("revenue_basis")
  /// How many incomplete tasks a member may hold at once. Null = unlimited.
  /// Checked when a task assignment is REQUESTED and again when it is APPROVED
  /// — without the second check a member requests five while free and a manager
  /// approves all five.
  maxConcurrentOpenTasks  Int?                   @default(1) @map("max_concurrent_open_tasks")
  /// OFF: inventory is an operational subledger only and COGS is not posted to
  /// the GL, matching cash-basis totalExpense. PERPETUAL capitalizes purchases
  /// and recognizes COGS at sale, which changes what totalExpense means.
  inventoryValuation      InventoryValuationMode @default(OFF) @map("inventory_valuation")
  /// File storage allowance in bytes. Null = the platform default (1 GB unless
  /// a superadmin changes it); set when a superadmin approves more.
  storageQuotaBytes       BigInt?                @map("storage_quota_bytes")
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")

  owner                  User                    @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members                WorkspaceMember[]
  cashbooks              Cashbook[]
  categories             Category[]
  contacts               Contact[]
  paymentModes           PaymentMode[]
  obligations            CashbookObligation[]
  peerLinksInitiated     PeerLink[]              @relation("PeerLinkInitiatorWorkspace")
  peerLinksCounterparty  PeerLink[]              @relation("PeerLinkCounterpartyWorkspace")
  unitsOfMeasure         UnitOfMeasure[]
  itemCategories         ItemCategory[]
  stockTransfersSent     StockTransfer[]         @relation("StockTransferSenderWorkspace")
  stockTransfersReceived StockTransfer[]         @relation("StockTransferRecipientWorkspace")
  rentalAgreements       RentalAgreement[]       @relation("RentalAgreementLenderWorkspace")
  auditLogs              AuditLog[]
  financialAuditLogs     FinancialAuditLog[]
  pendingInvites         PendingInvite[]
  profile                WorkspaceProfile?
  attachments            Attachment[]            @relation("WorkspaceAttachments")
  storageRequests        StorageQuotaRequest[]
  contactLinksAsA        ContactLink[]           @relation("ContactLinkWorkspaceA")
  contactLinksAsB        ContactLink[]           @relation("ContactLinkWorkspaceB")
  contactLinkRequestsOut ContactLinkRequest[]    @relation("ContactLinkRequestRequester")
  contactLinkRequestsIn  ContactLinkRequest[]    @relation("ContactLinkRequestRecipient")
  linkedFromContacts     Contact[]               @relation("ContactLinkedWorkspace")
  accountTypes           AccountType[]
  accounts               Account[]
  accountCategories      AccountCategory[]
  inventoryItems         InventoryItem[]
  inventoryRentals       InventoryRental[]
  taxes                  Tax[]
  productsServices       ProductService[]
  invoices               Invoice[]
  invoiceSettings        InvoiceSettings?
  projects               Project[]
  tasks                  Task[]
  workSessions           WorkSession[]
  timeEntries            TimeEntry[]
  taskAssignmentRequests TaskAssignmentRequest[]
  taskReports            TaskReport[]
  expenseClaims          TaskExpenseClaim[]
  attendanceSettings     AttendanceSettings?
  attendanceSites        AttendanceSite[]
  workSchedules          WorkSchedule[]
  holidays               Holiday[]
  attendanceDays         AttendanceDay[]
  leaveTypes             LeaveType[]
  leaveRequests          LeaveRequest[]
  overtimeRequests       OvertimeRequest[]
  attendanceFlags        AttendanceFlag[]
  workReports            WorkReport[]
  notifications          Notification[]
  ledgerAccounts         LedgerAccount[]
  journalEntries         JournalEntry[]
  fiscalPeriods          FiscalPeriod[]
  features               WorkspaceFeature[]
  ticketSettings         TicketSettings?
  ticketSessions         TicketSession[]
  ticketTypes            TicketType[]
  ticketDiscountRules    TicketDiscountRule[]
  ticketDays             TicketDay[]
  ticketShifts           TicketShift[]
  ticketSales            TicketSale[]
  tickets                Ticket[]
  membershipTiers        MembershipTier[]
  memberships            Membership[]
  apiKeys                ApiKey[]

  @@index([ownerId])
  @@index([type])
  @@map("workspaces")
}

model WorkspaceMember {
  id                  String        @id @default(uuid()) @db.Uuid
  /// Employment bounds and opt-out for attendance.
  ///
  /// Without these the absence rollup invents absences for the owner, for
  /// contractors, and for anyone hired mid-month — every day before they
  /// started would show as ABSENT.
  employmentStartDate DateTime?     @map("employment_start_date") @db.Date
  employmentEndDate   DateTime?     @map("employment_end_date") @db.Date
  attendanceTracked   Boolean       @default(true) @map("attendance_tracked")
  workspaceId         String        @map("workspace_id") @db.Uuid
  userId              String        @map("user_id") @db.Uuid
  role                WorkspaceRole @default(MEMBER)
  /// Which job this person does. Descriptive for every value except TICKETING —
  /// see the StaffTag docstring.
  staffTag            StaffTag?     @map("staff_tag")
  joinedAt            DateTime      @default(now()) @map("joined_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@index([workspaceId, staffTag])
  @@map("workspace_members")
}

/// A module unlocked for one organisation by a superadmin.
///
/// Absence of a row means the module does not exist for that org — its routes
/// answer 404 rather than 403, so an org that was never granted ticketing does
/// not learn it is there.
model WorkspaceFeature {
  id          String     @id @default(uuid()) @db.Uuid
  workspaceId String     @map("workspace_id") @db.Uuid
  feature     FeatureKey
  enabledAt   DateTime   @default(now()) @map("enabled_at")
  enabledById String     @map("enabled_by_id") @db.Uuid

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  enabledBy User      @relation("FeatureEnabler", fields: [enabledById], references: [id])

  @@unique([workspaceId, feature])
  @@index([workspaceId])
  @@map("workspace_features")
}

// ─── Cashbook ──────────────────────────────────────────

model Cashbook {
  id                  String   @id @default(uuid()) @db.Uuid
  workspaceId         String   @map("workspace_id") @db.Uuid
  name                String
  description         String?
  currency            String   @default("UGX")
  balance             Decimal  @default(0) @db.Decimal(20, 4)
  totalIncome         Decimal  @default(0) @map("total_income") @db.Decimal(20, 4)
  totalExpense        Decimal  @default(0) @map("total_expense") @db.Decimal(20, 4)
  allowBackdate       Boolean  @default(false) @map("allow_backdate")
  isActive            Boolean  @default(true) @map("is_active")
  /// When the book was retired. An archived book keeps every entry, drops out
  /// of the active list and refuses new ones, and can be restored.
  ///
  /// Distinct from isActive = false, which is deletion and is allowed only for
  /// a book that never recorded an entry.
  archivedAt          DateTime? @map("archived_at")
  /// Short, human-readable reference code for external API integrations.
  /// It is deliberately nullable: a book is not exposed to integrations until
  /// an authorised user explicitly activates it.
  bookRef             String?  @unique @map("book_ref")
  /// This book's private "unallocated book cash" ASSET account. Nullable only so
  /// the ledger can be introduced without a destructive migration; every
  /// cashbook created after Phase 1 has one.
  cashLedgerAccountId String?  @unique @map("cash_ledger_account_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  workspace             Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members               CashbookMember[]
  entries               Entry[]
  obligations           CashbookObligation[]
  peerLinksInitiated    PeerLink[]           @relation("PeerLinkInitiatorCashbook")
  peerLinksCounterparty PeerLink[]           @relation("PeerLinkCounterpartyCashbook")
  attachments           Attachment[]
  expenseClaims         TaskExpenseClaim[]
  invoices              Invoice[]
  cashLedgerAccount     LedgerAccount?       @relation(fields: [cashLedgerAccountId], references: [id], onDelete: Restrict)
  journalEntries        JournalEntry[]
  ticketSettings        TicketSettings?

  @@index([workspaceId])
  @@index([workspaceId, archivedAt])
  @@map("cashbooks")
}

model CashbookMember {
  id         String       @id @default(uuid()) @db.Uuid
  cashbookId String       @map("cashbook_id") @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  role       CashbookRole @default(VIEWER)
  joinedAt   DateTime     @default(now()) @map("joined_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  cashbook Cashbook @relation(fields: [cashbookId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cashbookId, userId])
  @@index([cashbookId])
  @@index([userId])
  @@map("cashbook_members")
}

// ─── Entry (Ledger) ────────────────────────────────────

model Entry {
  id                  String      @id @default(uuid()) @db.Uuid
  cashbookId          String      @map("cashbook_id") @db.Uuid
  type                EntryType
  amount              Decimal     @db.Decimal(20, 4)
  chargeAmount        Decimal?    @map("charge_amount") @db.Decimal(20, 4)
  description         String
  categoryId          String?     @map("category_id") @db.Uuid
  contactId           String?     @map("contact_id") @db.Uuid
  paymentModeId       String?     @map("payment_mode_id") @db.Uuid
  obligationId        String?     @map("obligation_id") @db.Uuid
  entryDate           DateTime    @map("entry_date")
  createdById         String      @map("created_by_id") @db.Uuid
  /// The API key that created this entry, when it originated from an external
  /// integration. Together with externalRef this provides durable idempotency
  /// and provenance without overloading the human description.
  integrationApiKeyId String?     @map("integration_api_key_id") @db.Uuid
  externalRef         String?     @map("external_ref")
  /// Mirrors (status == REVERSED). Retained so existing repository filters keep
  /// working through the cutover; dropped once every read path uses `status`.
  isDeleted           Boolean     @default(false) @map("is_deleted")
  deletedAt           DateTime?   @map("deleted_at")
  deletedReason       String?     @map("deleted_reason")
  /// Entries are never destroyed. A "delete" posts a reversing journal and flips
  /// this to REVERSED; the row and its journals stay for audit.
  status              EntryStatus @default(POSTED)
  reversedAt          DateTime?   @map("reversed_at")
  reversedById        String?     @map("reversed_by_id") @db.Uuid
  reversalReason      String?     @map("reversal_reason")
  version             Int         @default(1)
  isReconciled        Boolean     @default(false) @map("is_reconciled")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  cashbook            Cashbook             @relation(fields: [cashbookId], references: [id], onDelete: Cascade)
  category            Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  contact             Contact?             @relation(fields: [contactId], references: [id], onDelete: SetNull)
  paymentMode         PaymentMode?         @relation(fields: [paymentModeId], references: [id], onDelete: SetNull)
  obligation          CashbookObligation?  @relation(fields: [obligationId], references: [id], onDelete: SetNull)
  createdBy           User                 @relation(fields: [createdById], references: [id])
  audits              EntryAudit[]
  deleteRequests      DeleteRequest[]
  attachments         Attachment[]
  expenseClaim        TaskExpenseClaim?
  accountTransactions AccountTransaction[]
  ticketSale          TicketSale?
  membership          Membership?
  settlementRecorded  PeerLinkSettlement[] @relation("PeerLinkSettlementRecorded")
  settlementMatched   PeerLinkSettlement[] @relation("PeerLinkSettlementMatch")
  agreementExpense    RentalAgreement?     @relation("RentalAgreementExpense")
  agreementIncome     RentalAgreement?     @relation("RentalAgreementIncome")
  transferExpense     StockTransfer?       @relation("StockTransferExpense")
  transferIncome      StockTransfer?       @relation("StockTransferIncome")

  @@unique([cashbookId, integrationApiKeyId, externalRef])
  @@index([cashbookId])
  @@index([entryDate])
  @@index([categoryId])
  @@index([contactId])
  @@index([createdById])
  @@index([isDeleted])
  @@index([cashbookId, status, entryDate])
  @@index([integrationApiKeyId])
  @@map("entries")
}

model EntryAudit {
  id        String   @id @default(uuid()) @db.Uuid
  entryId   String   @map("entry_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  action    String
  changes   Json?
  oldValues Json?    @map("old_values")
  newValues Json?    @map("new_values")
  createdAt DateTime @default(now()) @map("created_at")

  entry Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@index([entryId])
  @@index([userId])
  @@index([createdAt])
  @@map("entry_audits")
}

// ─── Delete Request ────────────────────────────────────

model DeleteRequest {
  id          String              @id @default(uuid()) @db.Uuid
  entryId     String              @map("entry_id") @db.Uuid
  requesterId String              @map("requester_id") @db.Uuid
  reason      String
  status      DeleteRequestStatus @default(PENDING)
  reviewerId  String?             @map("reviewer_id") @db.Uuid
  reviewNote  String?             @map("review_note")
  reviewedAt  DateTime?           @map("reviewed_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  entry     Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  requester User  @relation("DeleteRequester", fields: [requesterId], references: [id])
  reviewer  User? @relation("DeleteReviewer", fields: [reviewerId], references: [id])

  @@index([entryId])
  @@index([requesterId])
  @@index([status])
  @@map("delete_requests")
}

// ─── Category ──────────────────────────────────────────

// ─── Obligations ───────────────────────────────────────

enum ObligationType {
  RECEIVABLE
  PAYABLE
}

enum ObligationStatus {
  OPEN
  PARTIAL
  PAID
  CANCELLED
}

model CashbookObligation {
  id                String           @id @default(uuid()) @db.Uuid
  workspaceId       String           @map("workspace_id") @db.Uuid
  cashbookId        String           @map("cashbook_id") @db.Uuid
  type              ObligationType
  title             String
  description       String?
  /// What is actually owed: principal + interest. The single figure every
  /// settlement, overpayment check and status transition works from — adding
  /// interest changes what this number IS, not how any of that behaves.
  totalAmount       Decimal          @map("total_amount") @db.Decimal(20, 4)
  /// The capital itself — the sum lent out, or the goods' value. Equals
  /// totalAmount for every obligation that carries no interest, which is why
  /// the column is NOT NULL and was backfilled rather than left optional.
  principalAmount   Decimal          @map("principal_amount") @db.Decimal(20, 4)
  /// The charge on top, FIXED at creation. Flat, not per-annum: a 10% loan of
  /// 100,000 owes 110,000 on day 1 and still owes 110,000 on day 400. Nothing
  /// accrues in the background, so the amount owed never moves on its own and
  /// the obligation's journal never needs re-posting.
  interestAmount    Decimal          @default(0) @map("interest_amount") @db.Decimal(20, 4)
  /// The percentage it was entered as, kept only so the figure can be shown
  /// back the way it was typed. interestAmount is the authority — a rate
  /// entered against a principal is resolved to an amount once, at creation.
  interestRate      Decimal?         @map("interest_rate") @db.Decimal(9, 4)
  outstandingAmount Decimal          @map("outstanding_amount") @db.Decimal(20, 4)
  status            ObligationStatus @default(OPEN)
  dueDate           DateTime?        @map("due_date")
  contactId         String?          @map("contact_id") @db.Uuid
  referenceType     String?          @map("reference_type") // e.g. 'INVOICE'
  referenceId       String?          @map("reference_id") @db.Uuid
  /// Set when this obligation is one side of a peer link. The two mirrored
  /// obligations (lender's RECEIVABLE, borrower's PAYABLE) both carry the same
  /// peerLinkId; payments on either side create cross-confirmable settlements.
  peerLinkId        String?          @map("peer_link_id") @db.Uuid
  archivedAt        DateTime?        @map("archived_at")
  /// Bumped on every amount change, so the obligation's journal can be reversed
  /// and re-posted under a fresh posting key.
  version           Int              @default(1)
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cashbook     Cashbook          @relation(fields: [cashbookId], references: [id], onDelete: Cascade)
  contact      Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  peerLink     PeerLink?         @relation(fields: [peerLinkId], references: [id], onDelete: SetNull)
  entries      Entry[]
  expenseClaim TaskExpenseClaim?

  @@index([workspaceId])
  @@index([cashbookId])
  @@index([status])
  @@index([dueDate])
  @@index([contactId])
  @@index([referenceType, referenceId])
  @@index([peerLinkId])
  @@map("cashbook_obligations")
}

// ─── Peer Links ────────────────────────────────────────
//
// A loan agreement between two platform users. The initiator proposes from one
// of their books; nothing touches any book until the counterparty accepts and
// chooses one of their own books. On acceptance, two mirrored obligations are
// created — a RECEIVABLE on the lender's book, a PAYABLE on the borrower's —
// so the platform's audit trail is the shared proof of the loan and both sides
// carry it in their own books.

enum PeerLinkStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

/// Which side of the loan the initiator is on. LENDING means the initiator's
/// obligation is a RECEIVABLE (money going out to the counterparty); BORROWING
/// means it is a PAYABLE. The counterparty always gets the mirror.
enum PeerLinkDirection {
  LENDING
  BORROWING
}

model PeerLink {
  id        String            @id @default(uuid()) @db.Uuid
  status    PeerLinkStatus    @default(PENDING)
  direction PeerLinkDirection

  initiatorUserId         String  @map("initiator_user_id") @db.Uuid
  initiatorWorkspaceId    String  @map("initiator_workspace_id") @db.Uuid
  initiatorCashbookId     String  @map("initiator_cashbook_id") @db.Uuid
  counterpartyUserId      String  @map("counterparty_user_id") @db.Uuid
  /// Chosen by the counterparty at acceptance. Nullable until then, and stays
  /// null if the link is declined or cancelled.
  counterpartyWorkspaceId String? @map("counterparty_workspace_id") @db.Uuid
  counterpartyCashbookId  String? @map("counterparty_cashbook_id") @db.Uuid

  title           String
  description     String?
  /// The currency both books must share. Taken from the initiating book so the
  /// two mirrored obligations can never be denominated differently.
  currency        String
  /// Same interest model as obligations: flat, resolved once at proposal time.
  /// interestAmount is the authority; interestRate is kept for display.
  principalAmount Decimal   @map("principal_amount") @db.Decimal(20, 4)
  interestAmount  Decimal   @default(0) @map("interest_amount") @db.Decimal(20, 4)
  interestRate    Decimal?  @map("interest_rate") @db.Decimal(9, 4)
  totalAmount     Decimal   @map("total_amount") @db.Decimal(20, 4)
  dueDate         DateTime? @map("due_date")

  declinedReason String?   @map("declined_reason")
  respondedAt    DateTime? @map("responded_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  initiatorUser         User                 @relation("PeerLinkInitiator", fields: [initiatorUserId], references: [id])
  counterpartyUser      User                 @relation("PeerLinkCounterparty", fields: [counterpartyUserId], references: [id])
  initiatorWorkspace    Workspace            @relation("PeerLinkInitiatorWorkspace", fields: [initiatorWorkspaceId], references: [id], onDelete: Cascade)
  counterpartyWorkspace Workspace?           @relation("PeerLinkCounterpartyWorkspace", fields: [counterpartyWorkspaceId], references: [id], onDelete: SetNull)
  initiatorCashbook     Cashbook             @relation("PeerLinkInitiatorCashbook", fields: [initiatorCashbookId], references: [id], onDelete: Cascade)
  counterpartyCashbook  Cashbook?            @relation("PeerLinkCounterpartyCashbook", fields: [counterpartyCashbookId], references: [id], onDelete: SetNull)
  /// Exactly two rows once accepted: the lender's RECEIVABLE and the borrower's
  /// PAYABLE. Told apart by comparing obligation.cashbookId with the
  /// initiator/counterparty cashbook ids above.
  obligations           CashbookObligation[]
  settlements           PeerLinkSettlement[]

  @@index([status])
  @@index([initiatorUserId])
  @@index([counterpartyUserId])
  @@map("peer_links")
}

// ─── Peer Link Settlements ─────────────────────────────
//
// Cross-confirmed settlement: when either party records a payment against their
// side of a peer link, a PENDING settlement is created for the counterparty to
// confirm — by recording the mirrored payment themselves, or by matching an
// entry they already recorded — or to reject. Neither book is ever written to
// by the other party's action; a payment only becomes "confirmed" when both
// books carry it.

enum PeerLinkSettlementStatus {
  PENDING
  CONFIRMED
  REJECTED
  /// The recording entry was reversed, so the settlement no longer stands.
  CANCELLED
}

model PeerLinkSettlement {
  id         String                   @id @default(uuid()) @db.Uuid
  peerLinkId String                   @map("peer_link_id") @db.Uuid
  status     PeerLinkSettlementStatus @default(PENDING)

  /// The entry that recorded this payment on the recorder's own book. Unique:
  /// one settlement per payment entry.
  entryId          String   @unique @map("entry_id") @db.Uuid
  obligationId     String   @map("obligation_id") @db.Uuid
  recordedByUserId String   @map("recorded_by_user_id") @db.Uuid
  amount           Decimal  @db.Decimal(20, 4)
  entryDate        DateTime @map("entry_date")

  /// The counterparty's entry that confirmed this payment — the mirrored entry
  /// they recorded (or had already recorded and matched). Unique when set, so
  /// one entry can never confirm two different payments.
  matchedEntryId String? @unique @map("matched_entry_id") @db.Uuid

  respondedAt    DateTime? @map("responded_at")
  responseReason String?   @map("response_reason")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  peerLink       PeerLink @relation(fields: [peerLinkId], references: [id], onDelete: Cascade)
  recordedByUser User     @relation("PeerLinkSettlementRecorder", fields: [recordedByUserId], references: [id])
  entry          Entry    @relation("PeerLinkSettlementRecorded", fields: [entryId], references: [id])
  matchedEntry   Entry?   @relation("PeerLinkSettlementMatch", fields: [matchedEntryId], references: [id], onDelete: SetNull)

  @@index([peerLinkId])
  @@index([status])
  @@index([entryId])
  @@index([matchedEntryId])
  @@map("peer_link_settlements")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String
  description String?
  color       String?
  icon        String?
  isActive    Boolean  @default(true) @map("is_active")
  /// Optional income/expense account this category posts to. Unmapped categories
  /// fall back to the seeded Sales Revenue / General Expenses accounts, so the
  /// user-facing category flow is unchanged.
  glAccountId String?  @map("gl_account_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entries        Entry[]
  glAccount      LedgerAccount?   @relation(fields: [glAccountId], references: [id], onDelete: SetNull)
  ticketSettings TicketSettings[]
  ticketTypes    TicketType[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("categories")
}

// ─── Contact ───────────────────────────────────────────

enum ContactType {
  PERSONAL
  CUSTOMER
  VENDOR
  /// A member of the organisation, as a counterparty.
  ///
  /// Needed so an approved out-of-pocket expense can open a payable owed to the
  /// person who paid it: AP is tracked against a Contact, and a User is not one.
  STAFF
}

model Contact {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @map("workspace_id") @db.Uuid
  type        ContactType @default(PERSONAL)
  name        String
  email       String?
  phone       String?
  company     String?
  notes       String?
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  /// Set when this contact stands for a member of the workspace. Lets a
  /// reimbursement find (or create) the same counterparty every time instead of
  /// making a new "Jane Doe" per claim.
  userId String? @map("user_id") @db.Uuid

  /// Set when this contact is a live connection to another workspace on the
  /// platform rather than details someone typed in. The name/email/phone/
  /// company columns above (and the CustomerProfile below) stay the single
  /// place everything reads from — invoices, obligations and reports need no
  /// knowledge of linking — but for a linked contact they are a CACHE of the
  /// counterparty's own WorkspaceProfile, refreshed when they change it.
  ///
  /// Deliberately keyed on the workspace, not the user: a person can be both
  /// STAFF here (which occupies the [workspaceId, userId] unique below) and
  /// the face of a supplier org, and those must be able to coexist.
  linkedWorkspaceId String? @map("linked_workspace_id") @db.Uuid
  contactLinkId     String? @map("contact_link_id") @db.Uuid

  /// The exact values the last sync wrote, so a later sync can tell "still
  /// what we wrote" (safe to refresh) from "a human edited this since"
  /// (leave it alone). Without this, syncing would silently clobber the
  /// local corrections people make to a counterparty's details.
  linkedSnapshot Json?     @map("linked_snapshot")
  linkedSyncedAt DateTime? @map("linked_synced_at")

  workspace        Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user             User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  linkedWorkspace  Workspace?           @relation("ContactLinkedWorkspace", fields: [linkedWorkspaceId], references: [id], onDelete: SetNull)
  contactLink      ContactLink?         @relation(fields: [contactLinkId], references: [id], onDelete: SetNull)
  entries          Entry[]
  customerProfile  CustomerProfile?
  obligations      CashbookObligation[]
  invoices         Invoice[]
  inventoryRentals InventoryRental[]
  projects         Project[]
  memberships      Membership[]

  /// One staff contact per person per workspace.
  @@unique([workspaceId, userId])
  /// One contact per connected workspace — the guard that makes "link into the
  /// existing row" the only possible outcome of accepting twice.
  @@unique([workspaceId, linkedWorkspaceId])
  @@index([workspaceId])
  @@index([type])
  @@index([contactLinkId])
  @@map("contacts")
}

// ─── Cross-workspace contact connections ───────────────
//
// Recording a counterparty who is themselves on the platform, by asking them
// rather than typing their details in. The request is addressed to a USER, not
// a workspace: which of their workspaces answers is chosen at acceptance, so a
// person in several orgs sees one request and decides which org it belongs to.
// That is also why "first workspace to accept wins" needs no cleanup — the
// request was never sitting in the others to begin with.

enum ContactLinkRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

enum ContactLinkState {
  ACTIVE
  /// Either side stopped sharing. Both keep the details they already had —
  /// they are business records — but no further updates flow.
  REVOKED
}

model ContactLinkRequest {
  id     String                   @id @default(uuid()) @db.Uuid
  status ContactLinkRequestStatus @default(PENDING)

  requesterUserId      String @map("requester_user_id") @db.Uuid
  requesterWorkspaceId String @map("requester_workspace_id") @db.Uuid

  /// How the requester files them once connected. The recipient's own side
  /// defaults to the inverse (a CUSTOMER here is a VENDOR there).
  requestedType ContactType @default(CUSTOMER) @map("requested_type")

  /// An existing hand-typed contact this connection should attach to, resolved
  /// when the request is sent. Keeps entries and invoices already recorded
  /// against that row intact instead of stranding them beside a new duplicate.
  requesterContactId String? @map("requester_contact_id") @db.Uuid

  /// The address the request is aimed at, lowercased. Always set — it is what
  /// an invite is emailed to, and what a later signup is matched against, so
  /// it is the stable key whether or not an account exists yet.
  recipientEmail       String  @map("recipient_email")

  /// Null while the invitee has no account. Filled in the moment someone signs
  /// up with `recipientEmail`, which is what moves the request into their
  /// inbox to accept or decline like any other.
  recipientUserId      String? @map("recipient_user_id") @db.Uuid
  /// Chosen by the recipient at acceptance. Null until then, and stays null
  /// if declined, cancelled or expired.
  recipientWorkspaceId String? @map("recipient_workspace_id") @db.Uuid
  recipientType        ContactType? @map("recipient_type")

  message        String?
  declinedReason String?   @map("declined_reason")
  respondedAt    DateTime? @map("responded_at")
  expiresAt      DateTime  @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  requesterUser      User        @relation("ContactLinkRequester", fields: [requesterUserId], references: [id])
  recipientUser      User?       @relation("ContactLinkRecipient", fields: [recipientUserId], references: [id])
  requesterWorkspace Workspace   @relation("ContactLinkRequestRequester", fields: [requesterWorkspaceId], references: [id], onDelete: Cascade)
  recipientWorkspace Workspace?  @relation("ContactLinkRequestRecipient", fields: [recipientWorkspaceId], references: [id], onDelete: SetNull)
  link               ContactLink?

  @@index([recipientUserId, status])
  /// Looked up on every signup, to hand a new account the invites already
  /// waiting for its address.
  @@index([recipientEmail, status])
  @@index([requesterWorkspaceId, status])
  @@index([status])
  @@map("contact_link_requests")
}

model ContactLink {
  id    String           @id @default(uuid()) @db.Uuid
  state ContactLinkState @default(ACTIVE)

  /// Stored with the lexicographically smaller id as A, so the same pair can
  /// never be inserted twice in opposite order.
  workspaceAId String @map("workspace_a_id") @db.Uuid
  workspaceBId String @map("workspace_b_id") @db.Uuid

  requestId String? @unique @map("request_id") @db.Uuid

  revokedByWorkspaceId String?   @map("revoked_by_workspace_id") @db.Uuid
  revokedAt            DateTime? @map("revoked_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  workspaceA Workspace           @relation("ContactLinkWorkspaceA", fields: [workspaceAId], references: [id], onDelete: Cascade)
  workspaceB Workspace           @relation("ContactLinkWorkspaceB", fields: [workspaceBId], references: [id], onDelete: Cascade)
  request    ContactLinkRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  contacts   Contact[]

  @@unique([workspaceAId, workspaceBId])
  @@index([state])
  @@map("contact_links")
}

/// Platform-wide switches, set by a superadmin and true of every workspace at
/// once.
///
/// Distinct from WorkspaceFeature, which unlocks a module for ONE organisation.
/// Some decisions are not per-org at all — whether contact details may be typed
/// in by hand is a statement about how the product works, and granting it to
/// one workspace while refusing the next would be arbitrary rather than
/// deliberate.
///
/// Key/value so a new switch costs a row rather than a migration.
model PlatformSetting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation("PlatformSettingEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("platform_settings")
}

// ─── Referrals ─────────────────────────────────────────
//
// A superadmin appoints someone a referral agent; they share a link carrying
// their code, and whoever signs up through it is credited to them. Attribution
// is first-touch and permanent — the row is written once, when the account is
// created, and never rewritten.

enum ReferralSource {
  /// Followed the agent's share link; the code rode along automatically.
  LINK
  /// Typed the code into the signup form — a code heard rather than clicked.
  CODE
}

enum ReferralStatus {
  /// Account created; the address behind it is still unproven.
  SIGNED_UP
  /// Email verified, so this is a person rather than a typo or a throwaway.
  /// The distinction is what stops referral counts from rewarding noise.
  VERIFIED
}

model ReferralAgent {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @map("user_id") @db.Uuid

  /// The shareable code. Uppercase, and generated from an alphabet with the
  /// confusable characters (O/0, I/1/L) removed, because these get read aloud
  /// and written on paper as often as they get clicked.
  code String @unique

  /// Revoking sets this false rather than deleting the row: the referrals
  /// already credited to them still have to point somewhere.
  isActive Boolean @default(true) @map("is_active")

  appointedById String    @map("appointed_by_id") @db.Uuid
  appointedAt   DateTime  @default(now()) @map("appointed_at")
  revokedAt     DateTime? @map("revoked_at")
  notes         String?

  user        User       @relation("ReferralAgentUser", fields: [userId], references: [id], onDelete: Cascade)
  appointedBy User       @relation("ReferralAgentAppointer", fields: [appointedById], references: [id])
  referrals   Referral[]

  @@index([isActive])
  @@map("referral_agents")
}

model Referral {
  id      String @id @default(uuid()) @db.Uuid
  agentId String @map("agent_id") @db.Uuid

  /// One attribution per person, ever — enforced here rather than in code, so
  /// a second signup path can never quietly double-credit the same account.
  referredUserId String @unique @map("referred_user_id") @db.Uuid

  /// The code exactly as used, snapshotted. An agent's code could be reissued
  /// later; what earned this referral should not change with it.
  code         String
  source       ReferralSource
  /// Which signup route was taken. Worth keeping: it is the only way to see
  /// whether link attribution is actually surviving the OAuth round trip.
  signupMethod AuthProvider   @map("signup_method")

  status       ReferralStatus @default(SIGNED_UP)
  attributedAt DateTime       @default(now()) @map("attributed_at")
  verifiedAt   DateTime?      @map("verified_at")

  agent        ReferralAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  referredUser User          @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([agentId, status])
  @@index([attributedAt])
  @@map("referrals")
}

/// A workspace's own identity and billing details — who it is when it appears
/// in someone else's books, and the issuer half of its invoices.
///
/// Distinct from CustomerProfile, which is a workspace's record of SOMEONE
/// ELSE. This is the half that was missing: there was previously nowhere for
/// an org to state its own legal name, tax id or address.
model WorkspaceProfile {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @unique @map("workspace_id") @db.Uuid

  /// What counterparties see. Required — everything else may be blank.
  displayName String  @map("display_name")
  legalName   String? @map("legal_name")
  email       String?
  phone       String?
  website     String?

  /// Billing side. Optional by design: a connection is useful long before
  /// anyone has a tax id to put on an invoice.
  taxId          String? @map("tax_id")
  registrationNo String? @map("registration_no")
  addressLine1   String? @map("address_line1")
  addressLine2   String? @map("address_line2")
  city           String?
  state          String?
  postalCode     String? @map("postal_code")
  country        String?
  billingEmail   String? @map("billing_email")
  /// Bank / mobile-money instructions, free-form per market.
  paymentDetails Json?   @map("payment_details")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_profiles")
}

model CustomerProfile {
  id              String   @id @default(uuid()) @db.Uuid
  contactId       String   @unique @map("contact_id") @db.Uuid
  billingAddress  Json?    @map("billing_address")
  shippingAddress Json?    @map("shipping_address")
  currency        String?
  accountNumber   String?  @map("account_number")
  taxId           String?  @map("tax_id")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

// ─── Payment Mode ──────────────────────────────────────

model PaymentMode {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entries        Entry[]
  ticketSettings TicketSettings[]
  ticketSales    TicketSale[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("payment_modes")
}

// ─── Attachment ────────────────────────────────────────

/// A stored file, owned by exactly one thing.
///
/// cashbookId used to be required, which meant nothing outside a cashbook could
/// carry a file — no receipts on an expense claim, no evidence on a task report.
/// It is now one of four mutually exclusive owners, enforced by a CHECK in the
/// migration (num_nonnulls(...) = 1) rather than by convention.
///
/// One model rather than one per owner so that storage, presigning and soft
/// delete stay a single code path: two file stacks is how a delete ends up
/// removing the row on one side and orphaning the object on the other.
model Attachment {
  id             String    @id @default(uuid()) @db.Uuid
  cashbookId     String?   @map("cashbook_id") @db.Uuid
  entryId        String?   @map("entry_id") @db.Uuid
  taskId         String?   @map("task_id") @db.Uuid
  taskReportId   String?   @map("task_report_id") @db.Uuid
  expenseClaimId String?   @map("expense_claim_id") @db.Uuid
  /// The workspace whose storage this file counts against. Copied from the
  /// owning entry/task/report/claim so a quota check is one indexed sum
  /// rather than four joins.
  workspaceId    String?   @map("workspace_id") @db.Uuid
  fileName       String    @map("file_name")
  fileSize       Int       @map("file_size")
  mimeType       String    @map("mime_type")
  s3Key          String    @map("s3_key")
  uploadedById   String    @map("uploaded_by_id") @db.Uuid
  isDeleted      Boolean   @default(false) @map("is_deleted")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  cashbook     Cashbook?         @relation(fields: [cashbookId], references: [id], onDelete: Cascade)
  entry        Entry?            @relation(fields: [entryId], references: [id], onDelete: SetNull)
  task         Task?             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskReport   TaskReport?       @relation(fields: [taskReportId], references: [id], onDelete: Cascade)
  expenseClaim TaskExpenseClaim? @relation(fields: [expenseClaimId], references: [id], onDelete: Cascade)
  workspace    Workspace?        @relation("WorkspaceAttachments", fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([cashbookId])
  @@index([entryId])
  @@index([taskId])
  @@index([taskReportId])
  @@index([expenseClaimId])
  @@index([isDeleted])
  @@index([workspaceId, isDeleted])
  @@map("attachments")
}

// ─── Audit Log (System-wide) ───────────────────────────

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  workspaceId String?  @map("workspace_id") @db.Uuid
  action      String
  resource    String
  resourceId  String?  @map("resource_id")
  details     Json?
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([workspaceId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Financial Audit Log ───────────────────────────────

model FinancialAuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  workspaceId   String   @map("workspace_id") @db.Uuid
  cashbookId    String?  @map("cashbook_id") @db.Uuid
  accountId     String?  @map("account_id") @db.Uuid
  entryId       String?  @map("entry_id") @db.Uuid
  action        String
  amount        Decimal? @db.Decimal(20, 4)
  balanceBefore Decimal? @map("balance_before") @db.Decimal(20, 4)
  balanceAfter  Decimal? @map("balance_after") @db.Decimal(20, 4)
  details       Json?
  reason        String?
  createdAt     DateTime @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([userId])
  @@index([workspaceId])
  @@index([cashbookId])
  @@index([accountId])
  @@index([entryId])
  @@index([action])
  @@index([createdAt])
  @@map("financial_audit_logs")
}

/// Exactly-once guarantee for financial POSTs.
///
/// A client retrying after a timeout must not create a second entry. The record
/// is claimed before the handler runs and completed with the response, so a
/// retry with the same key replays the original response verbatim instead of
/// re-executing. Scoped by workspace so a key cannot leak across tenants, and by
/// endpoint so it cannot be reused for a different operation.
model IdempotencyRecord {
  id             String    @id @default(uuid()) @db.Uuid
  workspaceId    String?   @map("workspace_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  key            String
  /// Route template, e.g. "POST /entries/cashbook/:cashbookId".
  endpoint       String
  /// sha256 of the canonicalized request body. A different hash under the same
  /// key is a client bug, not a retry, and is rejected rather than replayed.
  requestHash    String    @map("request_hash")
  state          String    @default("IN_PROGRESS")
  responseStatus Int?      @map("response_status")
  responseBody   Json?     @map("response_body")
  resourceId     String?   @map("resource_id") @db.Uuid
  claimedAt      DateTime  @default(now()) @map("claimed_at")
  completedAt    DateTime? @map("completed_at")
  expiresAt      DateTime  @map("expires_at")

  @@unique([workspaceId, endpoint, key])
  @@index([expiresAt])
  @@index([userId])
  @@map("idempotency_records")
}

// ─── Enums ─────────────────────────────────────────────

enum WorkspaceType {
  PERSONAL
  BUSINESS
}

enum WorkspaceRole {
  /// Full control, including deleting the workspace.
  OWNER
  /// Everything except deleting the workspace.
  ADMIN
  /// Runs the operation day to day: staff, delivery, people ops and the full
  /// ticketing surface, with the same reach into books as an admin.
  ///
  /// Deliberately cannot do the things that change what the organisation IS or
  /// what its books MEAN: delete or rename the workspace, edit the chart of
  /// accounts, close a period, post a manual journal, bulk-import members, or
  /// appoint accountants. Those stay with the owner, the admin and the
  /// accountant.
  GENERAL_MANAGER
  /// Full accounting access across every book. Can add sub-accountants, and
  /// only sub-accountants.
  ACCOUNTANT
  /// Org-level accounting access, but cashbook data limited to the books they
  /// have been explicitly granted. Cannot manage members.
  SUB_ACCOUNTANT
  /// Runs projects and tasks org-wide: creates projects, assigns work, approves
  /// task reports and expense claims. NO financial access — books only through
  /// an explicit CashbookMember row.
  ///
  /// Distinct from ProjectRole.PROJECT_MANAGER, which delegates a SINGLE
  /// project to someone who is otherwise a plain member. Same name, different
  /// scope; always reference them qualified.
  PROJECT_MANAGER
  /// People operations: attendance settings, schedules, leave, overtime and
  /// work reports. May onboard and offboard staff, but can only ever assign
  /// MEMBER. NO financial access — books only through an explicit
  /// CashbookMember row.
  HR
  /// No org-financial access at all. Books they are an explicit member of,
  /// plus projects, tasks and time tracking.
  MEMBER
  /// Developer / integration role.
  ///
  /// Can list, create, and revoke workspace API keys, see the Book IDs they
  /// have been assigned to via CashbookMember, and access integration docs.
  /// No financial write access, no entry creation via the standard UI path —
  /// their principal is the workspace service account they authenticated with.
  DEVELOPER
}

enum CashbookRole {
  PRIMARY_ADMIN
  ADMIN
  BOOK_ADMIN
  DATA_OPERATOR
  VIEWER
}

/// What job somebody actually does, as distinct from what they are allowed to
/// do. Roles carry authority; tags carry assignment.
///
/// The reason this is a separate axis and not more roles: a bar attendant, a
/// maintenance hand and a social media manager all hold exactly MEMBER's
/// permissions. Minting a role per job title would have grown the permission
/// matrix by five entries that differ only in their name.
///
/// One exception, and it is deliberate: TICKETING is the only tag that grants
/// anything. It admits its holder to the ticket desk, so assigning it requires
/// MANAGE_TICKETING rather than plain MANAGE_MEMBERS — otherwise HR, who can
/// manage members, could hand out the ability to post money.
enum StaffTag {
  BAR
  RESTAURANT
  KITCHEN
  TICKETING
  MAINTENANCE
  SOCIAL_MEDIA
  SUPERVISOR
  SECURITY
  OTHER
}

/// Modules a superadmin unlocks per organisation.
///
/// Generic rather than a boolean column on Workspace so the next gated module
/// reuses the mechanism instead of adding another migration, and so there is a
/// record of who unlocked what and when.
